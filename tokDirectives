#SymbolType
addDescendentTypes addComponentField
    cout "addDescendentTypes:",symbol.name,symbol.methodName:;
#;
addMethod starting
    if name eq "GroupBody" item = 0;
#;
fillComponentFields if
    if name eq "Details" cout "fillComponentFields:",name,text:;
#;
fillComponentFields "component "
    if name eq "Details" cout `name,"checking type:",type.name`"Symbol",ancestor.symbol.name"":;
#;
fillComponentFields ancestor
    if name eq "Details" cout ``name,"ancestor:",ancestor.symbol.name,"type:",type.name:;
#;
fillComponentFields "instance.parent = ancestor"
    if name eq "Details" cout ```name,"from",type.name,"replacing",text,getQualifiedName():;
#;
fillComponentFields componentFields
    if name eq "Details" cout ```"adding to",name,"from",type.name,text,getQualifiedName():;
#;
fillComponentFields "if !instance" before
    if name eq "Details"
        if instance cout `"Found in",name,getQualifiedName():;
        else cout `name,"Adding null instance for",text:;
#;
setRefer isReferenced before active
    if name eq "notTypeGroupDraw" cout "SymbolType setRefer: " name:;
