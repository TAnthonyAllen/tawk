
/*******************************************************************************
	Note: methods with directives (including global methods with directives)
    must be defined in an external spec before the current class is defined.
    The body of global methods should appear after the current class definition.
    The order should be:
        external definitions of all methods w/directives
        class definition
        global methods
*******************************************************************************/
#globals
DebugDirectiveTawkAct directives active
    cout "DebugDirective: add directive for method",directiveMethod.name,"in type:",currentType.name:`codeMatch:;
#;
DirectiveTawkNow currentType  before active
    cout "Processing debug directives for",type:;
#;
MacroBitTawkNow if before
    cout `"MacroBit:",bitpart:;
#;
MacroBlockTawkNow for before
    cout "MacroBlock:",line:;
#;
MacroBodyTawkNow "if other.length" within
    cout "MacroBody: other",other:;
#;
MacroBodyTawkNow "if part" within
    cout "MacroBody: part",part:;
#;
MacroBodyTawkNow "if rest" within
cout "MacroBody: rest",rest:;
#;
MethodTypeTawkNow methodType
    cout "MethodType:",methodType.name:;
#;
Statement2TawkNow if before
    if currentMethod.name eq "interpret" cout "Saw directive statement for",currentMethod.name:;
#;

/*******************************************************************************
	Directive
*******************************************************************************/
#Directive
emitDirective starting active
    if atStart
        cout    ``"emitDirective: adding directive for method",method.name,"in type:",type.name," at start":;
    or atEnd
        cout    ``"emitDirective: adding directive for method",method.name,"in type:",type.name," at end":;
    or within
        cout    ``"emitDirective: adding directive for method",method.name,"in type:",type.name," within:"`codeMatch:;
    else cout   ``"emitDirective: add directive for method",method.name,"in type:",type.name," at:"`codeMatch:;
#;
parseDirective starting active
    if atStart
        cout "parseDirective: adding directive for method",method.name,"in type:",type.name," at start":;
    or atEnd
        cout "parseDirective: adding directive for method",method.name,"in type:",type.name," at end":;
    or within
        cout "parseDirective: adding directive for method",method.name,"in type:",type.name," within:"`codeMatch:;
    else cout "parseDirective: add directive for method",method.name,"in type:",type.name," at:"`codeMatch:;
    //debug = true;
#;
parseDirective ending
    debug = false;
#;

