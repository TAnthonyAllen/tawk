enD

TargetMethod
Symbol  symbol;
PLGitem name = target%"name";
    if currentClass.methods
        {
        symbol = currentClass.methods[name.string()];
        name.unString();
        }
    if symbol target.value = symbol;
    else return false;
enD

/*****************************************************************************
	Macro actions
*****************************************************************************/
MacroBit
Symbol  symbol;
    if symbol = macroHash[bitpart.toString()]
        iTEM.value = symbol;
    else return false;
enD

MacroBlock
Statement   statement;
PLGitem	    item;
int         indentFlag;
    for line
		{
		item = line.get("statement");
		if !item continue;
		statement = item.value;
        if !indentFlag
            {
            statement.indented = false;
            indentFlag  = true;
            }
		if statement
			currentBlock.add(statement);
		}
enD

MacroBody
PLGitem     body,
            last,
            other,
            part,
            rest;
    for parts
        {
        if body && !last last = body;
        if other = parts["other"]
            {
            if other.length
                {
                if !body body   = other;
                if !last last   = body;
                else {
//dealWith
                    last.next   = other;
                    last        = last.next;
                    }
                }
            if part = other.valueItem
                {
                if !body body   = part;
                if !last last   = body;
                else {
//dealWith
                    last.next   = part;
                    last        = last.next;
                    }
                other.valueItem = null;
                }
            }
        or rest = parts%"rest"
            {
            if !body body = rest;
            if !last last = body;
            else {
//dealWith
                last.next   = rest;
                last        = last.next;
                }
            }
        }
    currentMethod.commentItem = body;
enD

MacroDelimit
    macroDelimiter = delimiter.toString();
enD

MacroDefine
Symbol  argument,
        symbol;
Buffer  buffer = tokJunkBuffer;
    symbol  = new(name.string(),voidType);
    buffer.reset();
    print(buffer) symbol.name;
    if !macroHash macroHash = new;
    else macroHash.clear();
    if parameters
        {
        PLGitem item = parameters;
        isMethod = true;
        print "(";
        for item
            {
            PLGitem element = item.get("element");
            argument = new(element.string());
            argument.isAlias = true;
            symbol += argument;
            print argument.name;
//dealWith
            if item.next print ",";
            macroHash[argument.name] = (void*)argument;
            }
        print ")";
        }
    #resetPRINT
    methodName  = buffer.toString();
    isHidden    = true;
    // currentMethod is reused here temporarily then reset
    argument        = currentMethod;
    currentMethod   = symbol;
    if parameters
        divertInput(body.string(),getRule("MacroBody"));
    else {
        symbol.commentItem  = body;
        body.value          = null;
        }
    currentMethod           = argument;
    if !macroList macroList = new;
    macroList[symbol.name]  = (void*)symbol;
enD

MacroName
    if !macroList || !macroList[name.toString()] return false;
enD
