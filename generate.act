AliasItem
Symbol  symbol = name.value,
        method  = target.value;
    if method.type == symbol.type
        && (!method.parameters || (method.parentClass.isC && method.parameters.length == 1))
        {
        method.isGetter = true;
        method.getter   = symbol;
        symbol.getter   = method;
        }
    or method.parameters
        && (method.parameters.length == 1 || (method.parentClass.isC && method.parameters.length == 2))
        {
        method.isSetter = true;
        method.setter   = symbol;
        symbol.setter   = method;
        }
    else cerr "Could not set getter or setter for " symbol.name:;
enD

AliasItem:2
	currentClass.constructor = alias.toString();
enD

AliasItem:3
SymbolType	type;
String		name,
			targetName;
PLGitem		body        = value["body"],
            indirect    = value["indirect"],
            target      = value["target"],
            valueType   = value["type"];
	if !currentClass
		cerr "ERROR processing aliases: current class is not set\n";
	else {
		name = alias.toString();
		if valueType
			{
            SymbolType typeAlias = types.get(name);
			/*********************************************************************
				Creates a type alias.
			*********************************************************************/
            if indirect
                {
                if !typeAlias
                    {
                    typeAlias = getType(value.toString());
                    typeAlias.isType        = true;
                    typeAlias.isDirect      = true;
                    typeAlias.isAliasType   = true;
                    typeAlias.isGlobal      = true;
                    typeAlias.noDotH        = true;
                    }
                or typeAlias.isAliasType
                    typeAlias.name = value.toString();
                else cerr "AliasItem: cannot use a standard type as an alias",iTEM:;
                }
            else typeAlias = valueType.value;
            types.put(name,typeAlias);
			}
        else {
            if body
                {
                PLGitem arguments = divertInput(body.string(),"AliasParameters");
                body.unString();
                body = arguments["body"];
                }
            targetName  = target.string();
            currentClass.makeAlias(name,targetName,body,p);
            target.unString();
			}
		}
enD

CheckMacro
PLGrule     rule;
PLGitem	    item,
            macro;
Symbol	    argument,
            symbol;
int         count;
Buffer      buffer = tokJunkBuffer;
    if !macroList return false;
    symbol = macroList[statement.toString()];
    if !symbol return false;
    if braced
        {
        braced  =
        item    = braced.valueItem;
        for item count++;
        if symbol.parameters
            {
            if !count || count != symbol.parameters.length
                return false;
            }
        or count return false;
        symbol.parameters.entry = null;
        for item = braced
            {
            argument    = symbol.parameters.next();
            argument.commentItem = item["part"];
            }
        }
    buffer.reset();
    macro = symbol.commentItem;
    for macro
        if argument = macro.value
            {
            if item = argument.commentItem
                print(buffer) item;
            else print "No value supplied for " argument.name:;
            }
        else {
            print macro.string();
            macro.unString();
            }
    //cout "CheckMacro action: " buffer:;
	/*************************************************************************
		Need to convert tokJunkBuffer to string because it might get reset in
        the middle of the diversion.
	*************************************************************************/
    if buffer.length()
        {
        Statement   line = new();
        line.pointInCode = iTEM;
        Block       saveBlock = currentBlock;
        currentBlock = new;
        rule = rules["MacroBlock"];
        if item = divertInput(buffer.toString(),rule)
            {
            Instance instance = currentBlock.first.value;
            line.add(currentBlock);
            statement.value = line;
            if instance && instance.statement   instance.statement.indented = true;
            }
        currentBlock = saveBlock;
        }
#resetPRINT
enD

CheckMacroParameters
PLGitem body = braced["body"];
    if body
        {
        PLGitem list = divertInput(body.string(),"MacroArgumentList");
        body.unString();
        braced.valueItem = list["argument"];
        }

enD

ConditionLabel
	Conditions.add(label.string(),(void*)text.toString());
enD

Extender
Symbol      method;
String      text        = name.toString();
    method = currentClass.findField(text);
    if method method.extendType();
    else cerr "Overload could not find extender method:",iTEM:;
    name.unString();
enD

Field
Symbol  symbol;
    if currentClass.components
        {
        symbol = currentClass.components[name.string()];
        name.unString();
        }
    if symbol name.value = symbol;
    else return false;
enD

InitializerItem
SymbolType  type        = types.get(field);
String      text        = function.string();
String      signature   = text "(char*)";
Symbol      method      = currentClass[signature];
    if type
        if method
            {
            type.hasInitializer     = true;
            type.initializer        = method;
            method.isInitializer    = true;
            }
        else cerr "InitializerItem rule could not find initialer method:",signature:;
    else {
        Symbol virtualField = currentClass[field];
        if !virtualField
            if method
                {
                virtualField = new(field.toString(),method.type);
                virtualField.isHidden   = true;
                virtualField.getter     = method;
                currentClass += virtualField;
                }
            else cerr "InitializerItem rule could not find getter method:", signature:;
        else cerr "InitializerItem rule: virtual field",field,"already exists":;
        }
    function.unString();
enD

OverLoadItem
PLGitem     operand = operate.get("operand");
String      text = name.toString();
    assigning = false;
    if !operand operand = operate.get("comparator");
    if !currentClass
        cerr "Overload specification must be within class:",iTEM:;
    else currentClass.overload(operand.toString(),text);
    name.unString();
enD

OverLoadItem:2
String	text = name.toString();
	if currentClass
		if assign currentClass.overload("[]=",text);
		else currentClass.overload("[]",text);
	else cerr "Overload specification must be within class\n";
	currentClass.isVirtuous = true;
enD

OverLoadItem:3
