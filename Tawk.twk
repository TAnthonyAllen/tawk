void StructureTawkAct(PLGitem iTEM)
{
PLGitem kind = iTEM.children["kind"];
PLGitem body = iTEM.children["body"];
Symbol		symbol;
Instance	instance, current;
SymbolType	structureType;
PLGitem		item = body.get("label"),
			field = body.get("field"),
			entry = body.get("entry");
String		error;
    currentType = null;
	newType		=
	methodType	= null;
	if !item && kind eq "typedef"
		{
		PLGitem name = entry.get("name");
		structureType = SymbolType.find(name.string());
		if structureType && !structureType.isType
			{
			error = "typedef " name.string() " conflicts with existing class name\n";
			instance = makeError(error);
			}
		else {
			if !structureType
				{
				structureType           = getType(name.toString());
				structureType.isType    = true;
                structureType.isAtomic	= true;
				}
			instance = new(structureType);
			}
		name.unString();
		if currentClass.noDotH structureType.noDotH = true;
		else structureType.dotHname = currentClass.dotHname;
		goto finish;
		}
	processingParameters = true;
	body.runDeferred(this);
	processingParameters = false;
	structureType = currentType;
	structureType.noDotH = true;
	if !currentClass currentClass = currentType;
	if !item
		{
		String name = head(structureType.name,"Type");
		symbol = currentClass.getLocal(name);
		if !symbol
			{
			symbol = new(name,structureType);
			currentClass.add(symbol);
			isHidden = true;
			//	Note here, isHidden has to be set after adding
			}
		instance = new(symbol);
		}
	else {
		instance = item.value;
		structureType = instance.type;
//dealWith next
		if field body.next = field;
		or !currentClass.isExternal
            structureType.mustDeclare = true;
		}
	if (kind eq "boolean")
        {
		structureType.isBoolean = true;
        structureType.isNumber = true;
        }
	or (kind eq "enumerator")
        {
		structureType.isEnumerator  = true;
        structureType.isNumber      = true;
        globalList += (void*)structureType;
        }
	or (kind eq "struct")
		structureType.isStruct      = true;
	or (kind eq "typedef")
		structureType.isType        = true;
	else structureType.isUnion      = true;
	if isBoolean || isEnumerator
		for item = entry
			{
			current = item.value;
			symbol = current.symbol;
			if isEnumerator
                {
				symbol.type         = nullType;
                currentSymbols.addGlobalField(symbol.name,symbol);
                }
			or isBoolean
				if !array array     = ":1";
			}
finish:
    structureType.isExternal    = false;
	structureType.isDirect      = true;
    if currentClass != globalType
        structureType.parent    = currentClass;
	kind.value = structureType;
	body.value = instance;
	currentType = null;
}


void StructureBodyTawkAct(PLGitem iTEM)
{
PLGitem label = iTEM.children["label"];
PLGitem entry = iTEM.children["entry"];
PLGitem field = iTEM.children["field"];
Instance    current;
SymbolType  saveClass = currentClass;
PLGitem	    item,
			name;

	item = label.get("type");
	if !item.value
		{
		label.runDeferred(this);
		item = label.get("type");
		}
	currentClass = (SymbolType)item.value;
    for item = entry
		{
		item.runDeferred(this);
		name = item.get("name");
		if name item.value = name.value;
		}
	currentType = currentClass;
	currentType.isDirect = true;
	for field
		{
		field.runDeferred(this);
		item = field.get("item");
		current = item.value;
		field.value = current;
		}
	current = new(currentClass);
	currentClass = saveClass;
	label.value = current;
}


void StructureBody2TawkAct(PLGitem iTEM)
{
PLGitem entry = iTEM.children["entry"];
Symbol		symbol;
PLGitem		name = entry.find("name"),
			item;
    saveStruct = currentClass;
	if currentClass
		{
		symbol = currentClass.getLocal(name.string());
		name.unString();
		}
	if symbol currentClass = structType;
	else {
		String typeName = currentClass.name "Struct" toString(stringNumber++) "Type";
		currentClass = getType(typeName);
		}
	if currentClass currentClass.nameLess = true;
    for item = entry
		{
		item.runDeferred(this);
		name = item.get("name");
		if name item.value = name.value;
		}
	currentType = currentClass;
	currentClass = saveStruct;
    saveStruct  = null;
}


int TypeNameTawkNow(PLGitem iTEM)
{
PLGitem type = iTEM.children["type"];
SymbolType  symbolType;
    symbolType = SymbolType.find(type.string());
    type.unString();
    if symbolType
        {
        type.value = symbolType;
        return true;
        }
    return false;
return true;
}


void ConditionWordTawkAct(PLGitem iTEM)
{
PLGitem list = iTEM.children["list"];
PLGitem         item, text;
KeyTableItem    conditionItem;
Instance        condition;
String          conditionText;
    if conditionItem = list.value
        if conditionText = conditionItem.value
            if item = divertInput(conditionText,"Expression")
                {
                text = item.get("instance");
                if text
                    list.value = text.value;
                else {
                    condition = new();
                    condition.error("Failed parse of condition list");
                    list.value = condition;
                    }
                return;
                }
    cerr "Could not parse Condition:",list:;
}


