int QualifiedTawkNow(PLGitem iTEM)
{
PLGitem type = iTEM["type"];
PLGitem field = iTEM["field"];
PLGitem rest = iTEM["rest"];
PLGitem postfix = iTEM["postfix"];
Tawk	p = iTEM.testParser;
PLGitem	    item,
			tail,
			name = field.find("name");
Instance    parent,
			child;
    isQualified = false;
	if type
		{
		currentType = type.value;
		child = new(currentType);
		}
	if child isQualified = true;
    field.run();
    parent = name.value;
	/*************************************************************************
		If field is an assumed string, parent will be none so we bail
	*************************************************************************/
    if !parent return false;
	// The following inserts the parent class reference
	if child parent = parent.copyAndSetParent(child);
	currentType = parent.getType();
	if rest isQualified = true;
	/*************************************************************************
		If this is a qualifier (has following .) or if there is not symbol
		(unknown field) resolve virtue here
	*************************************************************************/
	if rest && currentType && currentType.isVirtuous && parent.arrayRef && !parent.resolved
		{
		parent = parent.checkOverload();
        if parent.resolved
            {
            currentType = parent.getType();
            // Not sure why I do the following
            if parent.reference && currentType.isOC
                parent.reference = false;
            }
		}
    for item = rest
		{
		tail = item.get("field");
		tail.run();
		name = tail.find("name");
		if child = name.value
            {
            if !child.symbol
                if currentType.isOC;
                or currentType.isVirtuous
                    {
                    String text = child.prefix " is not a valid symbol";
                    child.error(text);
                    }
            child = child.copyAndSetParent(parent);
            }
		parent = child;
		if !parent break;
		currentType = parent.getType();
		}
	saveType = currentType;
	currentType = null;
    if !parent return false;
    if postfix
        {
        Expression expression = new(parent,(Instance)null,postfix.string());
        postfix.unString();
        parent = new(expression);
        }
	/*************************************************************************
		Default parameters handled here because here we know the method parent
        if there is one.
	*************************************************************************/
    if parent.symbol && parent.isDefault && parent.isMethod
        parent.setDefaults(p);
    field.value = parent;
	isQualified = false;
return true;
}

int FieldExpressionTawkNow(PLGitem iTEM)
{
PLGitem cast = iTEM["cast"];
PLGitem direct = iTEM["direct"];
PLGitem instance = iTEM["instance"];
Tawk	p = iTEM.testParser;
Instance    castInstance, subject;
PLGitem	    item = instance["field"];
Instance    current = item.value;
	if direct
        current = current.setIndirectItem(direct);
    if cast
		{
		direct	= cast.get("direct");
		item	= cast.get("type");
		castInstance = item.value;
		if direct castInstance = castInstance.setIndirectItem(direct);
		subject = new(current);
		subject.cast = castInstance;
		current = subject;
		}
    instance.value = current;
return true;
}

int ExpressionTawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM["instance"];
PLGitem express = iTEM["express"];
Tawk	p = iTEM.testParser;
Expression  expression;
Instance    primary;
    primary = instance.value;
	if express
		{
		expression = makeExpress(primary,express);
		primary = new(expression);
		}
	if !primary.express
		{
		expression = new();
		subject = primary;
		primary = new(expression);
		}
    instance.value = primary;
	currentType = null;
return true;
}

int CastExpressionTawkNow(PLGitem iTEM)
{
PLGitem direct = iTEM["direct"];
PLGitem type = iTEM["type"];
PLGitem rest = iTEM["rest"];
Tawk	p = iTEM.testParser;
Instance instance = type.value;
    if rest
		{
		if !instance.isMethod
			instance.error("Cast Expression method reference expected");
		instance.parameters = rest.value;
		}
	instance.isCast = true;
	if direct instance.prefix = direct.string();
	currentType = null;
	if direct type.value = instance.setIndirectItem(direct);
return true;
}

