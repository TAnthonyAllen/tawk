int MacroBodyTawkNow(PLGitem iTEM)
{
PLGitem parts = iTEM.children["parts"];
PLGitem     body,
            last,
            other,
            part,
            rest;
    for parts
        {
        if body && !last last = body;
        if other = parts["other"]
            {
            if other.length
                {
                if !body body   = other;
                if !last last   = body;
                else {
//dealWith
                    last.next   = other;
                    last        = last.next;
                    }
                }
            if part = other.valueItem
                {
                if !body body   = part;
                if !last last   = body;
                else {
//dealWith
                    last.next   = part;
                    last        = last.next;
                    }
                other.valueItem = null;
                }
            }
        or rest = parts%"rest"
            {
            if !body body = rest;
            if !last last = body;
            else {
//dealWith
                last.next   = rest;
                last        = last.next;
                }
            }
        }
    currentMethod.commentItem = body;
return true;
}


