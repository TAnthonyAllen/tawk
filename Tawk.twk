int Case2TawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM["instance"];
Tawk	p = iTEM.testParser;
PLGitem     lastSwitch;
SymbolType  labelType, switchType;
Instance	switcher;
Instance	label = instance.value;
int         labelDirect, switchDirect;
    if switchStack
        if lastSwitch = switchStack.top()
            if switcher = lastSwitch.value
                {
                switchType      = switcher.getType();
                switchDirect    = switcher.howDirect();
                labelDirect     = label.howDirect();
                labelType       = label.getType();
                if switchType != labelType
                    if switchType.isNumber && labelType.isNumber
                        && labelDirect != switchDirect
                        label.error("switch/case type mismatch");
                or switchType == stringType && labelType == charType
                    && switchDirect != labelDirect
                    lastSwitch.flag4 = true;
                }
    if !isLabel
        {
        isLabel = true;
        isCase  = true;
        prefix = "case ";
        }
return true;
}

