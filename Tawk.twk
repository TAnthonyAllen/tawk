void DebugDirectiveTawkAct(PLGitem iTEM)
{
PLGitem method = iTEM["method"];
PLGitem body = iTEM["body"];
PLGitem locate = iTEM["locate"];
PLGitem active = iTEM["active"];
PLGitem code = iTEM["code"];
Tawk	p = iTEM.testParser;
/***************************************************************************
         The directive does not get added unless the matching method is found
         and the directive is marked as active
    ***************************************************************************/
    if active
        {
        String      text = method.string();
        if !body && (!locate || (locate.itemStart != 'e' && locate.itemStart != 's'))
            cerr "Directive for",text,"missing location":;
        else {
            Symbol      directiveMethod = currentType.getMethod(text);
            if !directiveMethod && currentType.isGlobal
                directiveMethod = findGlobalMethod(text);
            if directiveMethod
                {
                Directive   directive   = new;
                directive.type          = directiveMethod.parentClass;
                directive.method        = directiveMethod;
                if body codeMatch       = body.toString();
                codeToAdd               = code.toString();
                if locate
                    {
                    switch(*locate.itemStart)
                        {
                        case 'b':
                            comesBefore = true;
                        case 'e':
                            atEnd       = true;
                        case 's':
                            atStart     = true;
                        case 'w':
                            within      = true;
                        }
                    }
                if !directives directives = new;
                directives += directive;
                }
            else cerr "Could not find directive method:",text,"in type:",currentType.name:;
            }
        method.unString();
        }
}

