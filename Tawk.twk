            tail;
Expression  rangeX;
    item = back%"instance";
    tail = item.value;
    item = back%"operate";
    rangeX  = new(front,tail,item.string());
    front   = new(rangeX);
    front.isRange   = true;
    instance.value  = front;
return true;
}

