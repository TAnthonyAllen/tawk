int Else2TawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM.children["statement"];
PLGitem		action		= statement["action"];
PLGitem	    instance	= statement["instance"];
PLGitem		item		= action["statement"];
PLGitem		otherwise	= statement["otherwise"];
Instance    express		= instance.value;
Statement   line		= item.value;
Statement   ifStatement = new(IF);
use currentMethod
    ifStatement.add(express);
    pointInCode     = iTEM;
    if currentMethod && directives && !noLoop
        {
        Directive   directive;
        directives.reset();
        while directive = directives.next()
            if isDirected || !codeMatch continue;
            or !strncmp(codeMatch,pointInCode.itemStart,strlen(codeMatch))
                {
                noLoop = true;
                parseDirective();
                noLoop = false;
                break;
                }
        }
	line.indented   = true;
    if line ifStatement.add(line);
    if otherwise
		{
		item = otherwise.get("statement");
		line = item.value;
		if line ifStatement.add(line);
		}
    statement.value = ifStatement;
return true;
}


