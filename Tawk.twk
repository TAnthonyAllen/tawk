int CaseLabel2TawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM["instance"];
Tawk	p = iTEM.testParser;
PLGitem     item;
Instance    field;
Instance    rangeField;
Instance    label;
    rangeField = instance.value;
    if switchStack
        if item = switchStack.top()
            field = item.value;
    if field && rangeField
        label = new(convertRangeX(field,rangeField));
    label.isRange = true;
    field.isRange = true;   // set to flag switch as needing conversion
    instance.value = label;
return true;
}

int ParameterTawkNow(PLGitem iTEM)
{
PLGitem type = iTEM["type"];
PLGitem item = iTEM["item"];
Tawk	p = iTEM.testParser;
Symbol	    symbol;
PLGitem		last,
            name;
	methodType	= type.value;
	if !item
		{
		symbol = new("",methodType);
		name = new("no field specified");
		name.value = symbol;
		}
	else
	for item
		{
		item.run();
        if !last last = name = item["name"];
        or last.next = item["name"]
            last = last.next;
        symbol  = last.value;
        if type.flag4 symbol.isConst = true;
		}
	type.value = name;
return true;
}

void ParameterItemTawkAct(PLGitem iTEM)
{
PLGitem name = iTEM["name"];
