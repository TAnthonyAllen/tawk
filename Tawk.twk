int QuoteTawkNow(PLGitem iTEM)
{
PLGitem string = iTEM["string"];
PLGitem instance = iTEM["instance"];
PLGitem body = iTEM["body"];
Tawk	p = iTEM.testParser;
Buffer      buffer = tokJunkBuffer;
Instance    current;
char		*mark;
    /**********************************************************************
	    Check for multi-line strings
    **********************************************************************/
    buffer.reset();
    if !body    current = new("");
    else {
        mark    = body.string();
        while *mark {
			if *mark == '\n' {
                buffer += '\\';
                buffer += 'n'; }
            else    buffer += *mark;
            mark++; }
        current = new(buffer.toString());
        body.unString(); }
    isConstant  = true;
    indirection = 1; // constant strings are really pointers
    type        = SymbolType.stringType;
    if string   atString = true;
    instance.value      = current;
return true;
}

int AssumedStringTawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM["instance"];
Tawk	p = iTEM.testParser;
PLGitem     lastSwitch;
SymbolType  switchType;
Instance	switcher;
String      word = instance.string();
Instance    current;
int         switchDirect;
    if ReservedWord.find(word)
		{
		instance.unString();
		return false;
		}
    instance.unString();
    if switchStack
        if lastSwitch = switchStack.top()
            {
            switcher        = lastSwitch.value;
            switchType      = switcher.getType();
            switchDirect    = switcher.howDirect();
            if instance.length == 1
                {
                if switchType == charType || (switchType == stringType && !switchDirect)
                    {
                    word = "'" instance "'";
                    current = new(charType);
                    }
                or switchType == stringType && switchDirect == 1
                    {
                    word = instance.toString();
                    current = new(stringType);
                    }
                current.prefix = word;
                goto bailAssumed;
                }
            }
	current = new(instance.toString());
    current.indirection = 1; // constant strings are really pointers
    current.type = SymbolType.stringType;
bailAssumed:
    current.isConstant = true;
    instance.value = current;
return true;
}

int InitializerItemTawkNow(PLGitem iTEM)
{
PLGitem field = iTEM["field"];
PLGitem function = iTEM["function"];
Tawk	p = iTEM.testParser;
SymbolType  type        = types.get(field);
String      text        = function.string();
String      signature   = text "(char*)";
Symbol      method      = currentClass[signature];
    if type
        if method
            {
            type.hasInitializer     = true;
            type.initializer        = method;
            method.isInitializer    = true;
            }
        else cerr "InitializerItem rule could not find initialer method:",signature:;
    else {
        Symbol virtualField = currentClass[field];
        if !virtualField
            if method
                {
                virtualField = new(field.toString(),method.type);
                virtualField.isHidden   = true;
                virtualField.getter     = method;
                currentClass += virtualField;
                }
            else cerr "InitializerItem rule could not find getter method:", signature:;
        else cerr "InitializerItem rule: virtual field",field,"already exists":;
        }
    function.unString();
return true;
}

