{
	currentSymbols.presentClass =
    currentClass = t;
}

/******************************************************************************
	Current type setter
******************************************************************************/
void setCurrentType(SymbolType t)
{
    currentType = t;
}

/*******************************************************************************
        Create operators (without verbs)
*******************************************************************************/
void setOperators()
{
Operate    verb;
    verbs   = Operators;

    verb        = new("~",0);
        unary   = true;
    verb        = new("!",0);
        unary   = true;
    verb        = new("++",0);
        assign  = true;
        unary   = true;
    verb        = new("--",0);
        unary   = true;
        assign  = true;

    verb        = new("*",1);
    verb        = new("/",1);
    verb        = new("%",1);

    verb        = new("+",2);
        pointing = true;
    verb        = new("-",2);
        pointing = true;

    verb        = new(">>",3);
    verb        = new("<<",3);

    verb        = new("<",4);
        ltn     = true;
    verb        = new("lt",4);
        ltn     = true;
        call    = true;
    verb        = new("<=",4);
        lte     = true;
    verb        = new("le",4);
        lte     = true;
        call    = true;
    verb        = new(">",4);
        gtn     = true;
    verb        = new("gt",4);
        gtn     = true;
        call    = true;
    verb        = new(">=",4);
        gte     = true;
    verb        = new("ge",4);
        gte     = true;
        call    = true;

    verb        = new("==",5);
        eql     = true;
    verb        = new("eq",5);
        eql     = true;
        call    = true;
    verb        = new("!=",5);
        neq     = true;
    verb        = new("ne",5);
        neq     = true;
        call    = true;

    verb        = new("&",6);
    verb        = new("^",6);
    verb        = new("|",6);

    verb        = new("&&",7);
        conjunction = true;
    verb        = new("||",7);
        conjunction = true;
    verb        = new("?",7);
        question    = true;
    verb        = new(":",7);
        question    = true;
    
    verb        = new("=",10);
        assign  = true;
    verb        = new("+=",10);
        assign  = true;
    verb        = new("-=",10);
        assign  = true;
    verb        = new("*=",10);
        assign  = true;
    verb        = new("/=",10);
        assign  = true;
    verb        = new("%=",10);
        assign  = true;
    verb        = new(">>=",10);
        assign  = true;
    verb        = new("<<=",10);
        assign  = true;
    verb        = new("&=",10);
        assign  = true;
    verb        = new("^=",10);
        assign  = true;
    verb        = new("|=",10);
        assign  = true;

    commaOp     = new(",",11);
    verb        = new("..",11);
        isRange = true;
    verb        = new(">.",11);
        isRange = true;
    verb        = new(".<",11);
        isRange = true;
    verb        = new("><",11);
        isRange = true;
    //verbs.dump(false);
}

/*****************************************************************************
	Summary debugging data
*****************************************************************************/
void summaryDebug()
{
SymbolType  type;
int         t,c,m;
    cout "Summary of Types":;
    cout ```"  Name"```"Types"`"Components"``"Methods"``"Fields":;
    while type = types.next()
        if !isAtomic && (components || methods)
            {
            if componentTypes   t += componentTypes.length;
            if components       c += components.length;
            if methods          m += methods.length;
            cout name#20s`;
            if componentTypes   cout componentTypes.length#10d`;    else cout "         0"`;
            if components       cout components.length#10d`;        else cout "         0"`;
            if methods          cout methods.length#10d`;           else cout "         0":;
            }
    cout ```" Total"`t#10d`c#10d`m#10d:;
    summary(10);
}


int BlockTawkNow(PLGitem iTEM)
{
PLGitem start = iTEM.children["start"];
PLGitem line = iTEM.children["line"];
Statement   statement;
PLGitem	    item;
Block	    block;
Directive   directive;
use currentMethod
	block = start.value;
    for line
		{
		item = line.get("statement");
		if !item continue;
		statement = item.value;
		if statement
			block.add(statement);
		}
	if declaringMethod && currentMethod
        {
        declaringMethod = false;
        if directives
            {
            noLoop = true;
            directives.reset();
            while directive = directives.next()
                if !codeMatch parseDirective();
            noLoop = false;
            }
        }
    currentBlock = blockStack.pop();
    currentSymbols.pop("Block end");
return true;
}


int BlockStartTawkNow(PLGitem iTEM)
{
PLGitem brace = iTEM.children["brace"];
	if declaredSomething
        declaredSomething = false;
    currentSymbols.push("Block start");
    currentType = null;
	if declaringMethod && currentMethod
        {
        if !currentBlock
            currentMethod.pushParameters(currentSymbols);
        or lambdaMethod
            lambdaMethod.pushParameters(currentSymbols);
        }
    lambdaMethod = null;
    if currentBlock
		blockStack.push(currentBlock);
    currentBlock = new(1);
    iTEM.value = currentBlock;
    currentBlock.blockMethod = currentMethod;

    // virtualStack can get out of whack when an expression fails
    // so it gets cleaned up here if needed
    resetVirtuals();
return true;
}


int OperationTailTawkNow(PLGitem iTEM)
{
PLGitem operate = iTEM.children["operate"];
PLGitem instance = iTEM.children["instance"];
PLGitem question = iTEM.children["question"];
PLGitem	    item, operand;
SymbolType  type;
Expression	expression;
Instance	subject, trueValue;
String      flag,
            save = cursor;
	operand     = operate.get("operand");
	if operand
		{
        if stringing && expressType == stringType && !stringOP.foundIn(operand)
            return false;
		if operand.start == '=' && operand.length == 1
			flag = operand.start + 1;
		}
	or operand = operate.get("comparator")
        flag = operand.start + 3;
	if question
		{
		subject		= instance.value;
		trueValue	= question.value;
		expression	= new(subject,trueValue,"?");
		subject		= new(expression);
		instance.value = subject;
        flag        = null;
		}
	else subject = instance.value;
	if subject.parent && subject.isConstant
		instance.value	= (void*)subject;
    expressType =
    type        = subject.getType();
	if flag
		if type == stringType && subject.howDirect() == 1
			{
            cursor    = flag;
            stringing   = true;
            if item = parse("Strings")
                {
				subject = concatenate(item["item"]);
				instance.value = subject;
				}
            else cursor   = save;
            stringing       = false;
			}
    assigning   = false;
return true;
}


int OperationTail2TawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM.children["instance"];
PLGitem	question = instance.get("question");
	instance.value = question.value;
return true;
}


int MacroBlockTawkNow(PLGitem iTEM)
{
PLGitem line = iTEM.children["line"];
Statement   statement;
PLGitem	    item;
int         indentFlag;
    for line
		{
		item = line.get("statement");
		if !item continue;
		statement = item.value;
        if !indentFlag
            {
            statement.indented = false;
            indentFlag  = true;
            }
		if statement
			currentBlock.add(statement);
		}
return true;
}


void BodyTawkAct(PLGitem iTEM)
{
PLGitem body = iTEM.children["body"];

}


int Body2TawkNow(PLGitem iTEM)
{
PLGitem body = iTEM.children["body"];
Instance    method;
    body = body.get("method");
    method = body.value;
	if extending && method && symbol
		symbol.extendType();
return true;
}


int MethodNameTawkNow(PLGitem iTEM)
{
PLGitem name = iTEM.children["name"];
String	word = name.string();
SymbolType type = SymbolType.find(word);
    if ReservedWord.find(word) || (type && !type.isGlobal)
		{
		name.unString();
		return false;
		}
    name.unString();
return true;
}


int ClassHeadingTawkNow(PLGitem iTEM)
{
PLGitem nom = iTEM.children["nom"];
PLGitem attributes = iTEM.children["attributes"];
SymbolType  parent = null;
String	    className;
PLGitem		item, name, path, type;
Symbol		symbol;
	extending	= false;
    referring   = true;
    currentBlock = null;
	name = nom.get("name");
	path = name.value;
	className       = name.toString();
	currentClass    = SymbolType.getType(className);
	for item = attributes
		{
		if !type type = item["type"];
		item.runDeferred(this);
		}
	if type parent = type.value;
	if parent
		{
		currentClass.parent = parent;
		if parent.isOC currentClass.isOC = true;
		}
    if currentComment
		currentClass.comment = extractComment();
	if currentClass.isOC
		{
		nameSet.set((int)':');
		if currentClass.parent
			{
			symbol					= new("super",currentClass.parent);
			symbol.isVirtual		= true;
			currentClass.add(symbol);
			}
		}
	if !currentClass.noDotH && !currentClass.isAtomic && !currentClass.dotHname
        && !currentClass.isProtocol
		currentClass.dotHname = path.toString();
	currentClass.isExternal = false;
    if directivesFile processDirectives();
return true;
}


int ClassHeading2TawkNow(PLGitem iTEM)
{
PLGitem externalRef = iTEM.children["externalRef"];
PLGitem structure = iTEM.children["structure"];
PLGitem	type = structure.get("body");
PLGitem kind = structure.get("kind");
PLGitem field;
Instance instance = null;
	extending = false;
    if kind eq "typedef" || kind eq "struct"
        return false;
    field = type.next;
    structure.runDeferred(this);
    instance = type.value;
    currentClass = instance.getType();
    currentClass.noDotH = true;
	currentType = null;
	if externalRef currentClass.isExternal = true;
	else currentClass.isExternal = false;
	for field
		{
		instance = field.value;
		if instance
			{
			instance.isDeclaration = true;
			if symbol symbol.parentClass = globalType;
			}
		}
return true;
}


int ClassHeading3TawkNow(PLGitem iTEM)
{
PLGitem kind = iTEM.children["kind"];
PLGitem nom = iTEM.children["nom"];
PLGitem attributes = iTEM.children["attributes"];
SymbolType  parent = null;
String	    className, dotHfile;
PLGitem		entry, item, name, dotH, path, temp, type;
Symbol		symbol;
    currentBlock = null;
	extending = false;
    if !nom
		{
		currentClass = globalType;
		extending = true;
		}
    else
	for entry = nom
		{
		name = entry.get("name");
        temp = entry.get("temp");
		path = name.value;
		dotH = entry.get("dotH");
		className = name.toString();
		if dotH
			{
			dotHfile = path.toString();
            if !nom.next
                {
                // rename the class since it is not really a class, just the name of a file
                className               = "notType" className;
                currentClass            = SymbolType.getType(className);
                currentClass.isGlobal   = true;
                currentClass.isExternal = true;
                globalList += (void*)currentClass;
                extending = true;
                }
            else continue;
			}
		else currentClass = SymbolType.getType(className);
        if temp currentClass.isTemplate = true;
		for item = attributes
			item.runDeferred(this);
		if type parent = type.value;
		currentClass.isExternal = true;
		if parent
			{
			currentClass.parent = parent;
			if parent.isOC currentClass.isOC = true;
			}
		if !currentClass.noDotH && !currentClass.isAtomic && !currentClass.dotHname
			currentClass.dotHname = path.toString();
		if currentClass.isOC
			{
			nameSet.set((int)':');
			if currentClass.parent
				{
				symbol					= new("super",currentClass.parent);
				symbol.isVirtual		= true;
				currentClass.add(symbol);
				}
			}
		entry.value = currentClass;
		}
	if nom && nom.next && dotHfile
		{
		for entry = nom
			{
            if !entry.value continue;
			currentClass = (SymbolType)entry.value;
			currentClass.dotHname = dotHfile;
			}
		currentClass = (SymbolType)nom.value;
		}
    if kind
        if kind.start == 't'
            {
            currentClass.isDirect   = true;
            currentClass.isType     = true;
            }
        else {
            currentClass.isDirect   = true;
            currentClass.isStruct   = true;
            }
return true;
}


