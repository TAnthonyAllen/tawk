Expression  xpress;
	item.runDeferred(this);
    methodD = parameters.value;
    methodD.isDeclaration = true;
    if methodD.symbol
        {
        if !currentBlock    methodD.symbol.parentClass = currentClass;
        if currentMethod && currentMethod == methodD.symbol  currentMethod = null;
        }
    if instance
        {
        methodI = instance.value;
        xpress  = new(methodD,methodI,"=");
        methodD = new(xpress);
        }
    item.value = methodD;
}


void DeclareItem2TawkAct(PLGitem iTEM)
{
PLGitem item = iTEM.children["item"];
PLGitem argument = iTEM.children["argument"];
String      text;
Symbol      symbol;
PLGitem     name        = item.get("name"),
            parameter   = argument.get("instance");
Instance    instance    = new(currentType.name),
            part        = parameter.value;
    /**********************************************************************
        converting constructor
    **********************************************************************/
    instance.addParameter(part);
    text = instance.mangle();
    if symbol = currentType.getMethod(text)
        {
		symbol = new(name.toString(),currentType);
        symbol.indirect = 0;
        symbol.isConstructor = true;
        instance.symbol = symbol;
        instance.prefix = null;
        instance.isMethod = true;
        }
    else instance.error("Could not find converting constructor");
    item.value = instance;
}


void DeclareItem3TawkAct(PLGitem iTEM)
{
PLGitem item = iTEM.children["item"];
PLGitem assign = iTEM.children["assign"];
PLGitem initialize = iTEM.children["initialize"];
PLGitem	    direct = item.get("direct"),
			name	= item.get("name"),
			array	= item.get("array"),
			bits	= item.get("bits");
Symbol	    symbol;
Instance    instance, assigned;
Expression  express;
String		text = name.toString();
	if !currentBlock
		symbol = currentClass.getLocal(text);
	if currentBlock || !symbol
		{
		symbol = new(text,currentType);
		if direct
			symbol.setIndirection(direct);
		if array
			{
			symbol.indirect += (long)array.value;
			symbol.isArray = (unsigned int)array.getAmount();
			tokJunkBuffer.reset();
			for array
				array.copyTo(tokJunkBuffer);
			symbol.array = tokJunkBuffer.toString();
			}
		or bits
			symbol.array = bits.toString();
		}
    instance = new(symbol);
    instance.isDeclaration = true;
	instance.block = currentBlock;
    if !direct && !currentType.isDirect
		symbol.indirect = 1;
    if assign
		{
		PLGitem	assignItem = assign.get("instance");
		assigned = assignItem.value;
		express = new(instance,assigned,"=");
		instance = new(express);
        instance.isRange = assigned.isRange;
		}
    item.value = instance;
}


void StructureItemTawkAct(PLGitem iTEM)
{
PLGitem item = iTEM.children["item"];
PLGitem		declare = item.get("declare");
PLGitem		entry;
Instance	instance;
Symbol      aliasSymbol;
	item.runDeferred(this);
	for entry = declare
		{
		instance = entry.value;
		if instance
			{
			currentClass.add(symbol);
			symbol.structType = currentClass;
            if saveStruct
                {
                aliasSymbol = new(symbol);
                aliasSymbol.isHidden = true;
                aliasSymbol.isItem   = true;
                saveStruct.add(aliasSymbol);
                }
			}
		}
}


void StructureItem2TawkAct(PLGitem iTEM)
{
PLGitem name = iTEM.children["name"];
PLGitem bits = iTEM.children["bits"];
PLGitem buttons = iTEM.children["buttons"];
String		text = name.toString();
Symbol	    aliasSymbol,symbol;
Instance    instance;
SymbolType	symbolType;
	symbolType = SymbolType.getType("unsigned int");
	symbol = currentClass.getLocal(text);
	if !symbol
		{
		symbol = new(text,symbolType);
		symbol.structType = currentClass;
        if bits
            {
            PLGitem length  = bits["length"];
            symbol.array    = bits.toString();
            symbolBitLength = atoi(length.string());
            length.unString();
            }
        else symbolBitLength = 1;
        symbol.isItem = true;
		currentClass.add(symbol);
        // saveStruct, if set, is the class containing the structure
        if saveStruct
            {
            aliasSymbol = new(symbol);
            aliasSymbol.isHidden = true;
            aliasSymbol.isItem   = true;
            saveStruct.add(aliasSymbol);
            }
		}
    else {
        if bits
            symbol.array = bits.toString();
        symbol.isItem = true;
        }
    instance = new(symbol);
    name.value = instance;
	if buttons
		{
		PLGitem	button;
		buttons.runDeferred(this);
		button = buttons.get("button");
		for button
			{
            // for button items symbol.source is set to the button container symbol
			symbol          = button.value;
            symbol.isButton = true;
			symbol.source   = instance.symbol;
            if saveStruct
                {
                aliasSymbol = new(symbol);
                saveStruct.add(aliasSymbol);
                }
			}
		}
}


