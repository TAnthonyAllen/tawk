{
PLGitem name = iTEM.children["name"];
PLGitem	    head = name.get("head");
Instance	instance;
	processingParameters = true;
	name.runDeferred(this);
	instance = head.value;
    name.value = instance.symbol;
	processingParameters = false;
}


void ParameterItem2TawkAct(PLGitem iTEM)
{
PLGitem direct = iTEM.children["direct"];
PLGitem name = iTEM.children["name"];
PLGitem array = iTEM.children["array"];
Symbol	    symbol;
	symbol = new(name.toString(),currentType);
	if direct
		symbol.setIndirection(direct);
    if array
		{
		symbol.array = array.toString();
		for array
			{
			symbol.indirect++;
			symbol.isArray++;
			}
		}
    name.value = symbol;
}


void ParameterItem3TawkAct(PLGitem iTEM)
{
PLGitem name = iTEM.children["name"];
Symbol	    symbol;
	symbol = new("",currentType);
	symbol.array = name.toString();
	for name
		{
		symbol.indirect++;
		symbol.isArray++;
		}
    name.value = symbol;
	name.next = null;
}


void ParameterItem4TawkAct(PLGitem iTEM)
{
PLGitem name = iTEM.children["name"];
Symbol	    symbol;
	symbol = new("",currentType);
	symbol.setIndirection(name);
	name.value = symbol;
}


int PrintTawkNow(PLGitem iTEM)
{
PLGitem start = iTEM.children["start"];
PLGitem arguments = iTEM.children["arguments"];
PLGitem output = iTEM.children["output"];
PLGitem		item, argument;
Instance	method;
SymbolType  type;
Block		block = null;
Statement	statement;
Instance	converter,
            format,
            savePrinter = defaultPrinter,
			text;
    if item = start.get("printer")
        if output   method = processPrintTarget(output);
        else        method = item.value;
    else {
        item   = start.get("stdPrint");
        method  = item.value;
        }
	if !method.isPrintMethod
		{
		tokJunkBuffer.reset();
		for argument = arguments
			{
            format  = null;
			item    = argument.get("instance");
			text    = item.value;
			format = getFormat();
			type    = text.getType();
			if text.express && !text.express.verb && !text.cast
				text = getSubject();
			if text.isConstant && !text.isMethod
				tokJunkBuffer.append(text.prefix);
			or type != stringType && howDirect() <= 1 && type.getMethod("toString")
				tokJunkBuffer.append("%s");
			or format
				tokJunkBuffer.append(format.prefix);
			else {
				text.error("No toString method");
				tokJunkBuffer.append("%s");
				}
			}
		text            = new(tokJunkBuffer.toString());
        text.type       = stringType;
        text.isConstant = true;
        text.indirection = 1;
		method.addParameter(text);
		for argument = arguments
			{
			item = argument.get("instance");
			text = item.value;
			type = text.getType();
			if text.express && !text.express.verb && !text.cast
                text = text.getSubject();
            if text.isConstant && !text.isMethod continue;
			if type != stringType && howDirect() <= 1
				{
				Symbol toString = type.getMethod("toString");
				if toString
					{
					converter = new(toString);
					converter.parent = text;
					text = converter;
					}
				}
			method.addParameter(text);
			}
		}
	else {
		//		Print using the print target object's print methods
		//		Need to add a string concatenation loop
		if arguments.next block = new();
		for argument = arguments
			{
			item = argument.get("instance");
			text = item.value;
			method = generatePrint(text);
			if block
				{
				statement = new();
                statement.pointInCode = iTEM;
				statement.add(method);
				block.add(statement);
				}
			}
		if block method = new(block);
		}
	start.value = method;
    if output defaultPrinter = savePrinter;
return true;
}


