int StatementBody9TawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM.children["statement"];
Instance    instance = new("break");
Statement   line = new();
PLGitem     lastSwitch;
    line.add(instance);                         // break
    line.branch = true;
    statement.value = line;
// if break is in a switch case, set switch fall thru status
    if switchStack lastSwitch = switchStack.top();
    if lastSwitch && iterating == lastSwitch.length
        lastSwitch.flag1 = true;
return true;
}


int StatementBody10TawkNow(PLGitem iTEM)
