int UnaryExpression2TawkNow(PLGitem iTEM)
{
PLGitem operate = iTEM.children["operate"];
PLGitem cast = iTEM.children["cast"];
PLGitem instance = iTEM.children["instance"];
Expression  expression;
PLGitem	    item;
Instance    castInstance, subject;
SymbolType  virtualType;
    subject = instance.value;
//dealWith next not sure what !operate.next is guarding against
    if operate
		if operate eq "&" && !operate.next
			subject.reference = true;
		else {
			expression = new((Instance)null,subject,operate.toString());
			subject = new(expression);
			}
    if cast
		{
		item	= cast.get("type");
		castInstance = item.value;
        if !subject.express
            {
			expression = new((Instance)null,subject,(String)null);
			subject = new(expression);
			}
        else subject = new(subject);
        subject.cast = castInstance;
		}
    virtualType = subject.getType();
    if virtualType.overloads
        virtualItem = subject;
	instance.value = subject;
    currentType = virtualType;
return true;
}


