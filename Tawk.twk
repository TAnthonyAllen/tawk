int ForOptionTawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM["instance"];
PLGitem initial = iTEM["initial"];
PLGitem condition = iTEM["condition"];
PLGitem increment = iTEM["increment"];
Tawk	p = iTEM.testParser;
Statement statement = new(FOR);
Instance express = null;
PLGitem	item;
    statement.pointInCode = iTEM;
    if initial
		{
		item = initial.get("list");
		express = item.value;
		statement.first = express;
		}
	if condition
		{
		item = condition.get("instance");
		express = item.value;
        express.isCondition = true;
		statement.second = express;
		}
    if increment
		{
		item = increment.get("list");
		express = item.value;
		statement.third = express;
		}
    instance.value = statement;
    noShortcuts = false;
return true;
}

int ForOption2TawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM["instance"];
PLGitem name = iTEM["name"];
Tawk	p = iTEM.testParser;
Instance    initial, target, iterator = null;
SymbolType  type, objectType;
Symbol	    symbol, objectIterator;
String	    error;
Statement   statement = new(FOR);
Expression  express = null;
    statement.pointInCode = iTEM;
    initial = instance.value;
	target = initial.express.subject;
    if !target target = makeError("expression has no subject");
    or !target.symbol target = makeError("invalid subject");
    else {
		type = target.getType();
		if name
			{
			symbol = type.getLocal(name.string());
			name.unString();
			}
		or initial.howDirect() == 2
			{
			/***************************************************************
				Build double indirection loop
			***************************************************************/
			target = new(target);
			iterator = new(target);
			express = new(iterator,target,"&&");
			iterator = new(target);
			target.indirection = 1;
			iterator.postfix = "++";
			target = new(express);
			goto endForOption;
			}
		else symbol = type.getLocal("next");
		if !symbol
            {
            if initial.express.object
                if objectType = initial.express.object.getType()
                    if objectType != type && (objectIterator = objectType.getLocal("next()"))
                        {
                        iterator = new(objectIterator);
                        if type != objectType
                            {
                            iterator.cast = new(type);
                            iterator.cast.isCast = true;
                            iterator.cast.indirection = 1;
                            }
                        iterator.parent = initial.express.object;
                        express = new(target,iterator,"=");
                        initial = new(express);
                        target  = null;
                        iterator = null;
                        statementType = WHILE;
                        }
			or initial.howDirect() == 1 && type == stringType
				{
				iterator = new(target);
				target.indirection = 1;
				iterator.postfix = "++";
				}
			else {
				error = target.symbol.name " has no iterator";
				target = makeError(error);
				}
            }
		or !target.symbol.typeMatch(symbol.type)
			{
			error = "type of " symbol.name " does not match type of " target.symbol.name;
			target = makeError(error);
			}
		else {
			iterator = new(symbol);
			if type != symbol.type
				{
				iterator.cast = new(type);
				iterator.cast.isCast = true;
				iterator.cast.indirection = 1;
				}
			iterator.parent = target;
			express = new(target,iterator,"=");
			iterator = new(express);
			}
		}
endForOption:
    statement.first = initial;
    statement.second = target;
    statement.third = iterator;
    instance.value = statement;
return true;
}

