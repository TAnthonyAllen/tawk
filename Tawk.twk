int InitExpressionTawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM["instance"];
Tawk	p = iTEM.testParser;
Instance	subject;
PLGitem	    last,item;
SymbolType  type;

	subject = instance.value;
	type = subject.getType();
	if type == stringType && subject.howDirect() == 1
		{
        last = instance;
		while true
			{
			item = parse("StringExpression");
			if item
				{
				PLGitem expressItem = item.get("instance");
				Instance secondary = expressItem.value;
				type = secondary.getType();
				if type == stringType
                    {
					last.next = expressItem;
                    last = last.next;
                    }
				else break;
				}
			else break;
			}
		if instance.next
			{
			subject = concatenate(instance);
			instance.value = subject;
			}
		}
return true;
}

int RangeExpressionTawkNow(PLGitem iTEM)
