int PrintItem2TawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM.children["instance"];
PLGitem format = iTEM.children["format"];
Instance    item = instance.value;
    if format
        {
        PLGitem     width = format["width"];
        if format.length > 1
            { *format.start = '%'; }
        item.format = new(format.toString());
        item.format.type    = stringType;
        item.format.indirection = 1;
        item.format.isConstant  = true;
        if width
            {
            item.format.format = new(width.toString());
            item.format.format.type = intType;
            item.format.format.isConstant = true;
            }
        }
return true;
}


int PrintShortcutTawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM.children["instance"];
Instance item;
	if *instance.start == ','
		item	= new(" ");
    or *instance.start == '`'
        item    = new("\\t");
	else item	= new("\\n");
    item.isConstant = true;
    item.type = SymbolType.stringType;
	item.indirection = 1;
    instance.value = item;
return true;
}


int CastTypeTawkNow(PLGitem iTEM)
{
PLGitem type = iTEM.children["type"];
PLGitem direct = iTEM.children["direct"];
PLGitem array = iTEM.children["array"];
SymbolType  symbolType = type.value;
Instance    instance = new(symbolType);
char		*atDirect;
	if direct
		for (atDirect = direct.start + direct.length - 1;
			atDirect >= direct.start; atDirect--)
			if *atDirect == '*' indirection++;
			or *atDirect == '^' currentClass.hasLambda = isLambda = true;
			or *atDirect == '&' reference = true;
	if !symbolType.isDirect && !indirection indirection++;
    if reference || isLambda isMethod = true;
    if array
		instance.postfix = array.toString();
    type.value = instance;
return true;
}


