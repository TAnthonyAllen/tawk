int ClassNameTawkNow(PLGitem iTEM)
{
PLGitem path = iTEM.children["path"];
PLGitem name = iTEM.children["name"];
PLGitem temp = iTEM.children["temp"];
PLGitem dotH = iTEM.children["dotH"];
String	text;
    if temp name.length += temp.length;
	if name eq "extends" || name eq "external"
		{
		name.unString();
		return false;
		}
	else name.unString();
	if path
		{
		path.length += name.length;
		if dotH path.length += dotH.length;
		}
	or dotH
		{
		path = new(name);
		path.length += dotH.length;
		}
	else {
		text = name.string() ".h";
		path = new(text);
		name.unString();
		}
	name.value = path;
return true;
}


