int MacroDefineTawkNow(PLGitem iTEM)
{
PLGitem name = iTEM["name"];
PLGitem parameters = iTEM["parameters"];
PLGitem body = iTEM["body"];
Tawk	p = iTEM.testParser;
Symbol  argument,
        symbol;
Buffer  buffer = tokJunkBuffer;
    symbol  = new(name.string(),voidType);
    buffer.reset();
    print(buffer) symbol.name;
    if !macroHash macroHash = new;
    else macroHash.clear();
    if parameters
        {
        PLGitem item = parameters;
        isMethod = true;
        print "(";
        for item
            {
            PLGitem element = item.get("element");
            argument = new(element.string());
            argument.isAlias = true;
            symbol += argument;
            print argument.name;
            if item.next print ",";
            macroHash[argument.name] = (void*)argument;
            }
        print ")";
        }
    #resetPRINT
    methodName  = buffer.toString();
    isHidden    = true;
    // currentMethod is reused here temporarily then reset
    argument        = currentMethod;
    currentMethod   = symbol;
    if parameters
        divertInput(body.string(),getRule("MacroBody"));
    else {
        symbol.commentItem  = body;
        body.value          = null;
        }
    currentMethod           = argument;
    if !macroList macroList = new;
    macroList[symbol.name]  = (void*)symbol;
return true;
}

void DeclareItem2TawkAct(PLGitem iTEM)
{
PLGitem item = iTEM["item"];
PLGitem argument = iTEM["argument"];
Tawk	p = iTEM.testParser;
String      text;
Symbol      symbol;
PLGitem     name        = item.get("name"),
            parameter   = argument.get("instance");
Instance    instance    = new(currentType.name),
            part        = parameter.value;
    /**********************************************************************
        converting constructor
    **********************************************************************/
    instance.addParameter(part);
    text = instance.mangle();
    if symbol = currentType.getMethod(text)
        {
		symbol = new(name.toString(),currentType);
        symbol.indirect = 0;
        symbol.isConstructor = true;
        instance.symbol = symbol;
        instance.prefix = null;
        instance.isMethod = true;
        }
    else instance.error("Could not find converting constructor");
    item.value = instance;
}

void StructureItem2TawkAct(PLGitem iTEM)
{
PLGitem name = iTEM["name"];
PLGitem bits = iTEM["bits"];
PLGitem buttons = iTEM["buttons"];
Tawk	p = iTEM.testParser;
String		text = name.toString();
Symbol	    aliasSymbol,symbol;
Instance    instance;
SymbolType	symbolType;
	symbolType = SymbolType.getType("unsigned int");
	symbol = currentClass.getLocal(text);
	if !symbol
		{
		symbol = new(text,symbolType);
		symbol.structType = currentClass;
        if bits
            {
            PLGitem length  = bits["length"];
            symbol.array    = bits.toString();
            symbolBitLength = atoi(length.string());
            length.unString();
            }
        else symbolBitLength = 1;
        symbol.isItem = true;
		currentClass.add(symbol);
        // saveStruct, if set, is the class containing the structure
        if saveStruct
            {
            aliasSymbol = new(symbol);
            aliasSymbol.isHidden = true;
            aliasSymbol.isItem   = true;
            saveStruct.add(aliasSymbol);
            }
		}
    else {
        if bits
            symbol.array = bits.toString();
        symbol.isItem = true;
        }
    instance = new(symbol);
    name.value = instance;
	if buttons
		{
		PLGitem	button;
		buttons.run();
		button = buttons.get("button");
		for button
			{
            // for button items symbol.source is set to the button container symbol
			symbol          = button.value;
            symbol.isButton = true;
			symbol.source   = instance.symbol;
            if saveStruct
                {
                aliasSymbol = new(symbol);
                saveStruct.add(aliasSymbol);
                }
			}
		}
}

int LambdaNameTawkNow(PLGitem iTEM)
{
PLGitem name = iTEM["name"];
Tawk	p = iTEM.testParser;
Instance	instance;
String		text;
    if !currentClass.hasLambda return false;
    text = name.string();
	if !SymbolType.find(text)
		{
		instance = currentSymbols.find(text);
		name.unString();
		if instance && symbol && isLambda
			{
			// Create a copy of instance w/o isDeclaration set
			instance = new(symbol);
			name.value = instance;
			lambdaMethod = symbol;
			}
		else return false;
		}
	else {
		name.unString();
		return false;
		}
return true;
}

