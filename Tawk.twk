Symbol	symbol;
Instance instance;
    if currentClass.isC
        return false;
    symbol = new("this",currentClass);
    instance = new(symbol);
	name.value = instance;
return true;
}


void StatementTawkAct(PLGitem iTEM)
{
PLGitem statement = iTEM.children["statement"];

}


int Statement2TawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM.children["statement"];
Statement   line = statement.value;
use currentMethod
    if line
        {
        if !pointInCode pointInCode = iTEM;
        line.setIsUsed();
        if currentMethod && directives && !noLoop
            {
            Directive   directive;
            directives.reset();
            while directive = directives.next()
                if isDirected || !codeMatch continue;
                or !strncmp(codeMatch,pointInCode.itemStart,strlen(codeMatch))
                    {
                    noLoop              = true;
                    parsingDirective    = true;
                    parseDirective();
                    parsingDirective    = false;
                    noLoop              = false;
                    break;
                    }
            }
        }
return true;
}


int StatementBodyTawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM.children["statement"];
Statement   line = new();
PLGitem		comment = statement.get("comment");
Instance    instance;
	if comment
		instance = new(comment.toString());
	else instance = new(statement.toString());
    instance.isComment = true;
    line.add(instance);
    statement.value = line;
return true;
}


int StatementBody2TawkNow(PLGitem iTEM)
{
