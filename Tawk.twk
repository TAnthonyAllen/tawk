void StructureTawkAct(PLGitem iTEM)
{
PLGitem kind = iTEM["kind"];
PLGitem body = iTEM["body"];
Tawk	p = iTEM.testParser;
Symbol		symbol;
Instance	instance, current;
SymbolType	structureType;
PLGitem		item = body.get("label"),
			field = body.get("field"),
			entry = body.get("entry");
String		error;
    currentType = null;
	newType		=
	methodType	= null;
	if !item && kind eq "typedef"
		{
		PLGitem name = entry.get("name");
		structureType = SymbolType.find(name.string());
		if structureType && !structureType.isType
			{
			error = "typedef " name.string() " conflicts with existing class name\n";
			instance = makeError(error);
			}
		else {
			if !structureType
				{
				structureType           = getType(name.toString());
				structureType.isType    = true;
                structureType.isAtomic	= true;
				}
			instance = new(structureType);
			}
		name.unString();
		if currentClass.noDotH structureType.noDotH = true;
		else structureType.dotHname = currentClass.dotHname;
		goto finish;
		}
	processingParameters = true;
	body.run();
	processingParameters = false;
	structureType = currentType;
	structureType.noDotH = true;
	if !currentClass currentClass = currentType;
	if !item
		{
		String name = head(structureType.name,"Type");
		symbol = currentClass.getLocal(name);
		if !symbol
			{
			symbol = new(name,structureType);
			currentClass.add(symbol);
			isHidden = true;
			//	Note here, isHidden has to be set after adding
			}
		instance = new(symbol);
		}
	else {
		instance = item.value;
		structureType = instance.type;
		if field body.next = field;
		or !currentClass.isExternal
            structureType.mustDeclare = true;
		}
	if (kind eq "boolean")
        {
		structureType.isBoolean = true;
        structureType.isNumber = true;
        }
	or (kind eq "enumerator")
        {
		structureType.isEnumerator  = true;
        structureType.isNumber      = true;
        globalList += (void*)structureType;
        }
	or (kind eq "struct")
		structureType.isStruct      = true;
	or (kind eq "typedef")
		structureType.isType        = true;
	else structureType.isUnion      = true;
	if isBoolean || isEnumerator
		for item = entry
			{
			current = item.value;
			symbol = current.symbol;
			if isEnumerator
                {
				symbol.type         = nullType;
                currentSymbols.addGlobalField(symbol.name,symbol);
                }
			or isBoolean
				if !array array     = ":1";
			}
finish:
    structureType.isExternal    = false;
	structureType.isDirect      = true;
    if currentClass != globalType
        structureType.parent    = currentClass;
	kind.value = structureType;
	body.value = instance;
	currentType = null;
}

void StructureBodyTawkAct(PLGitem iTEM)
{
PLGitem label = iTEM["label"];
PLGitem entry = iTEM["entry"];
PLGitem field = iTEM["field"];
Tawk	p = iTEM.testParser;
Instance    current;
SymbolType  saveClass = currentClass;
PLGitem	    item,
			name;

	item = label.get("type");
	if !item.value
		{
		label.run();
		item = label.get("type");
		}
	currentClass = (SymbolType)item.value;
    for item = entry
		{
		item.run();
		name = item.get("name");
		if name item.value = name.value;
		}
	currentType = currentClass;
	currentType.isDirect = true;
	for field
		{
		field.run();
		item = field.get("item");
		current = item.value;
		field.value = current;
		}
	current = new(currentClass);
	currentClass = saveClass;
	label.value = current;
}

