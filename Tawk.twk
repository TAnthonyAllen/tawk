int StatementBody12TawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM["statement"];
PLGitem block = iTEM["block"];
Tawk	p = iTEM.testParser;
Statement   switchStatement = new(SWITCH);
PLGitem	    item    = block.get("start");
Block	    body    = item.value;
Instance    trigger = statement.value;
SymbolType  type;                                   // switch
    body.isSwitch = true;
    if trigger
        {
        type = trigger.getType();
        switchStatement.add(trigger);
        }
    switchStatement.add(body);
    if !trigger
        {
        // jiggery pokery to put body in right place w/no switch parameter
        switchStatement.second  = switchStatement.first;
        switchStatement.first   = null;
        }
    switchStatement.indented    = true;
    switchStatement.noFallThru  = !statement.flag1;
    statement.value = switchStatement;
    if !trigger || trigger.isRange
        || (!type.isNumber && !(type == stringType && trigger.howDirect() != 1))
        switchStatement.switching = true;
    switchStack.pop();
return true;
}

