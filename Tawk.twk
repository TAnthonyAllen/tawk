int Line2TawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM.children["statement"];
String      text;
Instance    label;
PLGitem     item;
Symbol      symbol;
    for item = name
        {
        text = name.string();
        label = currentSymbols.instances.get(text);
        if !label
            {
            symbol = new(name.toString(),voidType);
            label = new(symbol);
            label.isLabel = true;
            currentSymbols.add(label);
            }
        name.unString();
        if !label.isLabel
            cerr "ERROR: label " name " already in scope\n";
        }

return true;
}


