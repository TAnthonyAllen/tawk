		name.unString();
		if instance && symbol && isLambda
			{
			// Create a copy of instance w/o isDeclaration set
			instance = new(symbol);
			name.value = instance;
			lambdaMethod = symbol;
			}
		else return false;
		}
	else {
		name.unString();
		return false;
		}
return true;
}


