PLGitem run(String name)
{
	initializeKeyWords();
	if !rules.length
		{
		setRules();
		initialize();
		}
	return parse(name);
}
}
/*******************************************************************************
                Rule actions
            *******************************************************************************/

int BlockTawkNow(PLGitem iTEM)
{
PLGitem start = iTEM["start"];
PLGitem line = iTEM["line"];
Tawk	p = iTEM.testParser;
Statement   statement;
PLGitem	    item;
Block	    block;
Directive   directive;
use currentMethod
	block = start.value;
    for line
		{
		item = line.get("statement");
		if !item continue;
		statement = item.value;
		if statement
			block.add(statement);
		}
	if declaringMethod && currentMethod
        {
        declaringMethod = false;
        if directives
            {
            noLoop = true;
            directives.reset();
            while directive = directives.next()
                if !codeMatch parseDirective();
            noLoop = false;
            }
        }
    currentBlock = blockStack.pop();
    currentSymbols.pop("Block end");
return true;
}

int StatementBody16TawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM["statement"];
PLGitem instance = iTEM["instance"];
Tawk	p = iTEM.testParser;
Statement   doStatement = new(DO);
Instance    test = instance.value;
Statement   body = statement.value;             // do
    doStatement.add(body);
    doStatement.add(test);
    doStatement.pointInCode = iTEM;
    test.isCondition    = true;
    statement.value     = doStatement;
    iterating--;
return true;
}

int BlockStartTawkNow(PLGitem iTEM)
{
PLGitem brace = iTEM["brace"];
Tawk	p = iTEM.testParser;
	if declaredSomething
        declaredSomething = false;
    currentSymbols.push("Block start");
    currentType = null;
	if declaringMethod && currentMethod
        {
        if !currentBlock
            currentMethod.pushParameters(currentSymbols);
        or lambdaMethod
            lambdaMethod.pushParameters(currentSymbols);
        }
    lambdaMethod = null;
    if currentBlock
		blockStack.push(currentBlock);
    currentBlock = new(1);
    iTEM.value = currentBlock;
    currentBlock.blockMethod = currentMethod;

    // virtualStack can get out of whack when an expression fails
    // so it gets cleaned up here if needed
    resetVirtuals();
return true;
}

int ClassBlockStartTawkNow(PLGitem iTEM)
