void DeclarationTawkAct(PLGitem iTEM)
{
PLGitem outlet = iTEM["outlet"];
PLGitem modify = iTEM["modify"];
PLGitem type = iTEM["type"];
PLGitem declare = iTEM["declare"];
Tawk	p = iTEM.testParser;
Instance    staticCopy,
            instance;
Symbol	    symbol;
PLGitem	entry, item;
    currentType = type.value;
	newType		=
	methodType	= currentType;
	for item = modify
        if item.start == 'c' constDeclare     = true;
        or item.start == 'i' inlineDeclare    = true;
		or item.start == 's' staticDeclare    = true;
        or item.start == 'v' virtualDeclare   = true;
        else externDeclare = true;
	for entry = declare
		{
		entry.run();
		item = entry.get("item");
		instance = item.value;
		instance.isDeclaration = true;
		entry.value = instance;
		symbol = instance.getSymbol();
		if outlet symbol.isOutlet = true;
		if staticDeclare
			{
			symbol.isStatic = true;
			if instance.express
				{
				Statement statement = new();
                statement.pointInCode = iTEM;
				statement.add(instance);
				staticBlock.add(statement);
				symbol.isInitialized = true;
				}
            if symbol.isMethod addGlobalField(symbol.methodName,symbol);
            addGlobalField(symbol.name,symbol);
			}
        if constDeclare     symbol.isConst      = true;
        if inlineDeclare    symbol.isInline     = true;
		if staticDeclare    symbol.isStatic     = true;
		if virtualDeclare   symbol.isVirtual    = true;
        if externDeclare
            {
            symbol.isExtern         = true;
            currentClass.hasExtern  = true;
            }
		}
    currentType = null;
    if modify
        {
        constDeclare    = false;
        linkage         = false;
        }
}

int CaseLabel3TawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM["instance"];
Tawk	p = iTEM.testParser;
PLGitem		field = instance.get("field");
Instance	label = field.value;
Symbol		symbol = label.getSymbol();
	if symbol.type == buttonType
		|| (symbol.structType && symbol.structType.isEnumerator)
		{
        label = new("case ");
		if symbol.type == buttonType
			postfix     = symbol.array;
		else postfix    = symbol.name;
        label.type      = intType;
        isConstant      = true;
		}
    else prefix = "case ";
    isLabel = true;
    isCase  = true;
    instance.value = label;
    assuming    = false;
return true;
}

int AliasItem4TawkNow(PLGitem iTEM)
{
PLGitem alias = iTEM["alias"];
PLGitem value = iTEM["value"];
Tawk	p = iTEM.testParser;
SymbolType	type;
String		name,
			targetName;
PLGitem		body        = value["body"],
            indirect    = value["indirect"],
            target      = value["target"],
            valueType   = value["type"];
	if !currentClass
		cerr "ERROR processing aliases: current class is not set\n";
	else {
		name = alias.toString();
		if valueType
			{
            SymbolType typeAlias = types.get(name);
			/*********************************************************************
				Creates a type alias.
			*********************************************************************/
            if indirect
                {
                if !typeAlias
                    {
                    typeAlias = getType(value.toString());
                    typeAlias.isType        = true;
                    typeAlias.isDirect      = true;
                    typeAlias.isAliasType   = true;
                    typeAlias.isGlobal      = true;
                    typeAlias.noDotH        = true;
                    }
                or typeAlias.isAliasType
                    typeAlias.name = value.toString();
                else cerr "AliasItem: cannot use a standard type as an alias",iTEM:;
                }
            else typeAlias = valueType.value;
            types.put(name,typeAlias);
			}
        else {
            if body
                {
                PLGitem arguments = divertInput(body.string(),"AliasParameters");
                body.unString();
                body = arguments["body"];
                }
            targetName  = target.string();
            currentClass.makeAlias(name,targetName,body,p);
            target.unString();
			}
		}
return true;
}

int ExpressListTawkNow(PLGitem iTEM)
{
PLGitem list = iTEM["list"];
Tawk	p = iTEM.testParser;
Instance    left = null, right;
Expression  express;
PLGitem	    item, part;
    for item = list
		{
		part = item.get("instance");
		right = part.value;
		if left
			{
			express = new(left,right,",");
			left = new(express);
			}
		else left = right;
		}
    list.value  = left;
    noShortcuts = false;
return true;
}

int ExpressPartTawkNow(PLGitem iTEM)
{
PLGitem unaryOp = iTEM["unaryOp"];
PLGitem instance = iTEM["instance"];
PLGitem express = iTEM["express"];
Tawk	p = iTEM.testParser;
Expression  expression;
Instance    secondary,primary;
PLGitem		item,
            operand,
            operate,
            stringPart;
SymbolType	type, secondaryType;
    primary = instance.value;
	type = primary.getType();
    expressType = null;
	if express
		{
		if operate	= express["operate"]
			{
			operand	= operate%"operand";
			if !operand operand = operate%"comparator";
			}
		item	= express.get("instance");
		if item
            {
            secondary = item.value;
            if secondary.isRange
                {
                expression = convertRangeX(primary,secondary);
                primary = new(expression);
                }
            else {
                secondaryType = secondary.getType();
                if !operand && secondary && secondary.express
                    && secondary.verb eq ":"
                    {
                    expression = new(primary,secondary,"?");
                    primary = new(expression);
                    }
                or operand && operand eq "+=" && type == stringType
                    && secondaryType == stringType && primary.howDirect() == 1
                    {
                    operand.setString("=");
                    //plgStart = item.start;
                    stringing   = true;
                    if stringPart = parse("Strings")
                        {
                        item.next       = stringPart;
                        instance.next   = item;
                        }
                    else instance.next  = item;
                    secondary = concatenate(instance);
                    expression = new(primary,secondary,"=");
                    primary = new(expression);
                    }
                }
            }
		}
	if !expression && (primary.isVirtuous() || operand)
		{
		expression = makeExpress(primary,express);
		primary = new(expression);
		}
    if unaryOp
        {
        if unaryOp eq "&" && !unaryOp.next
            primary.reference = true;
        else {
            expression = new((Instance)null,primary,unaryOp.toString());
            primary = new(expression);
            }
        }
    primary         = primary.checkOverload();
    if primary.symbol && primary.symbol.isDefault
        primary.setDefaults(p);
    instance.value  = primary;
    currentType     = null;
    popVirtuals();
return true;
}

