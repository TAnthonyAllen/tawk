void ClassAttributesTawkAct(PLGitem iTEM)
{
PLGitem trait = iTEM["trait"];
Tawk	p = iTEM.testParser;
KeyTableItem    item = trait.value;
Symbol	symbol;
    switch(item.position)
        {
        case 1: // C
            if !currentClass.isC
                {
                currentClass.isC   = true;
                if !currentClass.parent
                    {
                    if currentClass.lastOffset > 0
                        cerr "ERROR: do not specify class as C after variables are declared\n";
                    symbol				= new("tHIS",currentClass);
                    symbol.isVirtual	= true;
                    symbol.isThis       = true;
                    currentClass.add(symbol);
                    symbol = symbol.makeAlias("this");
                    symbol.isThis       = true;
                    currentClass.add(symbol);
                    currentClass.lastOffset = 0;
                    }
                }
            break;
        case 2: // isChar
            currentClass.isChar		= true;
            break;
        case 3: // isNumber
            currentClass.isNumber	= true;
            break;
        case 4: // local
            currentClass.isLocal	= true;
            break;
        case 5: // no.h
            currentClass.noDotH		= true;
            break;
        case 6: // noClassForward
            currentClass.noClassForward = true;
            break;
        case 7: // OC
            if !currentClass.isOC
                {
                currentClass.isOC		= true;
                currentClass.isVirtuous = true;
                }
            break;
        case 8: // proper
            currentClass.proper		= true;
            break;
        case 9: //protocol
            currentClass.isProtocol	= true;
            currentClass.isOC       = true;
            break;
        case 10: // type
            currentClass.isType		= true;
            currentClass.isDirect	= true;
            break;
        case 11: // addClassNameToMethods
            currentClass.addClassNameToMethods  = true;
            break;
        }
}

int AliasItemTawkNow(PLGitem iTEM)
{
PLGitem name = iTEM["name"];
PLGitem target = iTEM["target"];
Tawk	p = iTEM.testParser;
Symbol  symbol = name.value,
        method  = target.value;
    if method.type == symbol.type
        && (!method.parameters || (method.parentClass.isC && method.parameters.length == 1))
        {
        method.isGetter = true;
        method.getter   = symbol;
        symbol.getter   = method;
        }
    or method.parameters
        && (method.parameters.length == 1 || (method.parentClass.isC && method.parameters.length == 2))
        {
        method.isSetter = true;
        method.setter   = symbol;
        symbol.setter   = method;
        }
    else cerr "Could not set getter or setter for " symbol.name:;
return true;
}

int CheckMacroTawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM["statement"];
PLGitem braced = iTEM["braced"];
Tawk	p = iTEM.testParser;
PLGrule     rule;
PLGitem	    item,
            macro;
Symbol	    argument,
            symbol;
int         count;
Buffer      buffer = tokJunkBuffer;
    if !macroList return false;
    symbol = macroList[statement];
    if !symbol return false;
    if braced
        {
        braced  =
        item    = braced.valueItem;
        for item count++;
        if symbol.parameters
            {
            if !count || count != symbol.parameters.length
                return false;
            }
        or count return false;
        symbol.parameters.entry = null;
        for item = braced
            {
            argument    = symbol.parameters.next();
            argument.commentItem = item["part"];
            }
        }
    buffer.reset();
    macro = symbol.commentItem;
    for macro
        if argument = macro.value
            {
            if item = argument.commentItem
                print(buffer) item;
            else print "No value supplied for " argument.name:;
            }
        else {
            print macro.string();
            macro.unString();
            }
    //cout "CheckMacro action: " buffer:;
	/*************************************************************************
		Need to convert tokJunkBuffer to string because it might get reset in
        the middle of the diversion.
	*************************************************************************/
    if buffer.length()
        {
        Statement   line = new();
        line.pointInCode = iTEM;
        Block       saveBlock = currentBlock;
        currentBlock = new;
        rule = rules["MacroBlock"];
        if item = divertInput(buffer.toString(),rule)
            {
            Instance instance = currentBlock.first.value;
            line.add(currentBlock);
            statement.value = line;
            if instance && instance.statement   instance.statement.indented = true;
            }
        currentBlock = saveBlock;
        }
#resetPRINT
return true;
}

