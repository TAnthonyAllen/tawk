    if symbol target.value = symbol;
    else return false;
return true;
}

void MethodHeadTawkAct(PLGitem iTEM)
{
PLGitem direct = iTEM["direct"];
PLGitem function = iTEM["function"];
PLGitem head = iTEM["head"];
Tawk	p = iTEM.testParser;
Symbol	    symbol,
			argument;
Instance	instance;
PLGitem	    item, atItem,
			ellipsis = head.get("ellipsis"),
			parameter = head.get("parameter");
String		name, methodName;
int			i, construct,
			lambda = direct && lambdaSet.foundIn(direct);
    if function
		name = function.toString();
	or lambda
		name = "lambda";
    else {
		name = methodType.name;
		construct = true;
		}
    if lambda currentClass.hasLambda = true;
	methodName = alloca(1000);
	strcpy(methodName, name);
	strcat(methodName,"(");
    for atItem = parameter
		{
		item = atItem.get("type");
		for item = item.value
			{
			symbol = item.value;
			if symbol.isLambda || (symbol.reference && symbol.isMethod)
				strcat(methodName,symbol.getSignature());
			else {
				strcat(methodName,symbol.type.name);
				for ( i = 0; i < symbol.indirect; i++ )
					strcat(methodName,"*");
				//if symbol.reference strcat(methodName,"&");
				}
			if item.next strcat(methodName,",");
			}
		if atItem.next strcat(methodName,",");
		or ellipsis symbol.hasEllipsis = true;
		}
	if ellipsis strcat(methodName,",null");
	strcat(methodName,")");
	symbol = null;
	if currentClass
        if currentClass.isGlobal
            symbol = findGlobalMethod(methodName);
        else symbol = currentClass.getMethod(methodName);
	/***************************************************************************
		If symbol then method was probably declared external and need to make
		sure the parameter names match up.
	***************************************************************************/
	if symbol
		{
        while symbol.source symbol = symbol.source;
		if !(currentClass.isGlobal && symbol.parentClass.isGlobal)
            && symbol.parentClass != currentClass
            goto newSymbol;
		if symbol.type != methodType
			cerr "Warning: multiple types for " methodName:;
        symbol.checkParameters(parameter);
		}
	else {
newSymbol:
		symbol = new(name,methodType);
		symbol.isMethod = true;
        if constDeclare     symbol.isConst      = true;
        if inlineDeclare    symbol.isInline     = true;
		if staticDeclare    symbol.isStatic     = true;
		if virtualDeclare   symbol.isVirtual    = true;
        if externDeclare
            {
            symbol.isExtern = true;
            currentClass.hasExtern = true;
            }
		if direct symbol.setIndirection(direct);
		for atItem = parameter
			{
			item = atItem.get("type");
			for item = item.value
				{
				argument = item.value;
				symbol.addParameter(argument);
				}
			}
		if ellipsis
			{
			Symbol lips = new("...",SymbolType.nullType);
			lips.hasEllipsis = true;
			lips.indirect = 0;
			lips.isDirect = true;
			symbol.addParameter(lips);
			symbol.hasEllipsis = true;
			}
		symbol.mangle();
		if currentClass && !currentMethod && !processingParameters
            && !lambda && !symbol.reference
			currentClass.addMethod(symbol);
		}
	symbol.isConstructor = construct;
	instance = new(symbol);
    head.value = instance;
	if !currentMethod && !processingParameters && !symbol.reference
        currentMethod = symbol;
    if instance.isLambda lambdaMethod = symbol;
}

int MethodTypeTawkNow(PLGitem iTEM)
{
PLGitem modify = iTEM["modify"];
PLGitem type = iTEM["type"];
PLGitem methodHead = iTEM["methodHead"];
Tawk	p = iTEM.testParser;
Instance	instance;
PLGitem		head, item;
    // follow is not used but apparently it has to be there. Figure out why.
	methodType	= type.value;
	for item = modify
        if item.start == 'c' constDeclare     = true;
        or item.start == 'i' inlineDeclare    = true;
		or item.start == 's' staticDeclare    = true;
        or item.start == 'v' virtualDeclare   = true;
        else externDeclare = true;
    methodHead.run();
    head = methodHead["head"];
    instance = head.value;
    if modify
        {
        constDeclare    = false;
        linkage         = false;
        }
    declaringMethod     = true;
return true;
}

void MethodTypeTawkAct(PLGitem iTEM)
{
PLGitem modify = iTEM["modify"];
PLGitem type = iTEM["type"];
PLGitem methodHead = iTEM["methodHead"];
Tawk	p = iTEM.testParser;
methodType	= type.value;
}

void NewTawkAct(PLGitem iTEM)
{
PLGitem instance = iTEM["instance"];
PLGitem type = iTEM["type"];
PLGitem body = iTEM["body"];
PLGitem initial = iTEM["initial"];
Tawk	p = iTEM.testParser;
/**********************************************************************
	    Need to check that parameters are of the right types
	    If type is not provided, it gets set in the expression that
	    invokes the new statement.
    **********************************************************************/
SymbolType  symbolType;
Symbol	    symbol = null;
Expression  express;
PLGitem	    item = null;
Instance    current = null,
			parameter = null;
String		allocator;
int         skipConstructor;

    if type symbolType = type.value;
    else symbolType = newType;
    if !symbolType
		symbolType = SymbolType.nullType;
    if symbolType == SymbolType.nullType
		current = new("No type found");
	if symbolType.constructor
        {
        if currentMethod && symbolType.constructor eq currentMethod.name
            {
            //currentMethod.isConstructor = true;
            skipConstructor =
            currentMethod.isInitialized = true;
            }
        if !skipConstructor
            allocator = symbolType.constructor;
        }
	if !allocator allocator = symbolType.name;
    if body
		{
		item = body["array"];
		if item
			{
			symbol = new("new",symbolType);
			current = new(symbol);
			current.isArray = (unsigned int)item.amount;
			}
		else {
			if symbolType.isOC
				{
				current = new("init");
				current.type	= symbolType;
				}
			else current	= new(allocator);
			current.isMethod = true;
			item = body["expression"];
			}
		}
	or symbolType.isOC
		{
		current			= new("init");
		current.isMethod = true;
		current.type	= symbolType;
		}
	else {
		current = new(allocator);
		current.isMethod = true;
		}
    for item
		{
		parameter = item.get("instance").value;
		current.addParameter(parameter);
		}
    if symbol && initial
		{
		parameter = initial.value;
		express = new(current,parameter,"=");
		current = new(express);
		}
	if !symbol
		{
		if symbolType.constructor && !skipConstructor
			{
            parameter = currentSymbols.findMethod(current);
            if parameter
                {
                symbol = parameter.symbol;
                current.parent = parameter.parent;
                }
            else {
                skipConstructor = true;
                symbol = symbolType.findMethod(current);
                }
			}
		else symbol = symbolType.findMethod(current);
		if !symbol
			if !symbolType.isOC symbol = new(symbolType.name,symbolType);
			else {
				symbol = symbolType.getLocal("init");
				if !symbol
					{
					symbol = new("init",symbolType);
					symbol.isMethod     = true;
                    symbol.isOCfield    = true;
					symbol.parentClass  = symbolType;
					}
				}
		if !current
			current = new(symbol);
		else current.symbol = symbol;
        current.type    = null;
		current.prefix  = null;
		if !symbolType.isOC
			if symbolType.constructor && !skipConstructor
                current.type = symbolType;
            else current.prefix = "new ";
		}
    if !symbolType.constructor current.isNew = true;
    current.isConstant = false;
    instance.value = current;
}

