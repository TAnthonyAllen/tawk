void DeclarationTawkAct(PLGitem iTEM)
{
PLGitem outlet = iTEM.children["outlet"];
PLGitem modify = iTEM.children["modify"];
PLGitem type = iTEM.children["type"];
PLGitem declare = iTEM.children["declare"];
Instance    staticCopy,
            instance;
Symbol	    symbol;
PLGitem	entry, item;
    currentType = type.value;
	newType		=
	methodType	= currentType;
	for item = modify
        if item.start == 'c' constDeclare     = true;
        or item.start == 'i' inlineDeclare    = true;
		or item.start == 's' staticDeclare    = true;
        or item.start == 'v' virtualDeclare   = true;
        else externDeclare = true;
	for entry = declare
		{
		entry.runDeferred(this);
		item = entry.get("item");
		instance = item.value;
		instance.isDeclaration = true;
		entry.value = instance;
		symbol = instance.getSymbol();
		if outlet symbol.isOutlet = true;
		if staticDeclare
			{
			symbol.isStatic = true;
			if instance.express
				{
				Statement statement = new();
                statement.pointInCode = iTEM;
				statement.add(instance);
				staticBlock.add(statement);
				symbol.isInitialized = true;
				}
            if symbol.isMethod addGlobalField(symbol.methodName,symbol);
            addGlobalField(symbol.name,symbol);
			}
        if constDeclare     symbol.isConst      = true;
        if inlineDeclare    symbol.isInline     = true;
		if staticDeclare    symbol.isStatic     = true;
		if virtualDeclare   symbol.isVirtual    = true;
        if externDeclare
            {
            symbol.isExtern         = true;
            currentClass.hasExtern  = true;
            }
		}
    currentType = null;
    if modify
        {
        constDeclare    = false;
        linkage         = false;
        }
}


void Declaration2TawkAct(PLGitem iTEM)
{
PLGitem declare = iTEM.children["declare"];
PLGitem	field = declare.get("body");
PLGitem kind = declare.get("kind");
SymbolType structureType;
Instance instance = null;
    declare.runDeferred(this);
//dealWith next
	if kind structureType = kind.value;
	if !currentClass.isExternal && structureType && structureType.isType
		cerr "WARNING typedef ignored: must be declared external\n";
	declare.next = field;
	for field
		{
		instance = field.value;
		if instance
			instance.isDeclaration = true;
		}
}


