void ClassAttributesTawkAct(PLGitem iTEM)
{
PLGitem trait = iTEM.children["trait"];
KeyTableItem    item = trait.value;
Symbol	symbol;
    switch(item.position)
        {
        case 1: // C
            if !currentClass.isC
                {
                currentClass.isC   = true;
                if !currentClass.parent
                    {
                    if currentClass.lastOffset > 0
                        cerr "ERROR: do not specify class as C after variables are declared\n";
                    symbol				= new("tHIS",currentClass);
                    symbol.isVirtual	= true;
                    symbol.isThis       = true;
                    currentClass.add(symbol);
                    symbol = symbol.makeAlias("this");
                    symbol.isThis       = true;
                    currentClass.add(symbol);
                    currentClass.lastOffset = 0;
                    }
                }
            break;
        case 2: // isChar
            currentClass.isChar		= true;
            break;
        case 3: // isNumber
            currentClass.isNumber	= true;
            break;
        case 4: // local
            currentClass.isLocal	= true;
            break;
        case 5: // no.h
            currentClass.noDotH		= true;
            break;
        case 6: // noClassForward
            currentClass.noClassForward = true;
            break;
        case 7: // OC
            if !currentClass.isOC
                {
                currentClass.isOC		= true;
                currentClass.isVirtuous = true;
                }
            break;
        case 8: // proper
            currentClass.proper		= true;
            break;
        case 9: //protocol
            currentClass.isProtocol	= true;
            currentClass.isOC       = true;
            break;
        case 10: // type
            currentClass.isType		= true;
            currentClass.isDirect	= true;
            break;
        case 11: // addClassNameToMethods
            currentClass.addClassNameToMethods  = true;
            break;
        }
}


