	item.run();
    methodD = parameters.value;
    methodD.isDeclaration = true;
    if methodD.symbol
        {
        if !currentBlock    methodD.symbol.parentClass = currentClass;
        if currentMethod && currentMethod == methodD.symbol  currentMethod = null;
        }
    if instance
        {
        methodI = instance.value;
        xpress  = new(methodD,methodI,"=");
        methodD = new(xpress);
        }
    item.value = methodD;
}

