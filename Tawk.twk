    line.add(block);							// Block
    statement.value = line;
return true;
}


int StatementBody3TawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM.children["statement"];
PLGitem		action		= statement["action"];
PLGitem	    instance	= statement["instance"];
PLGitem		item		= action["statement"];
PLGitem		otherwise	= statement["otherwise"];
Instance    express		= instance.value;
Statement   ifStatement = new(IF);
Statement   line		= item.value;               // if
    ifStatement.add(express);
    express.isCondition = true;
	line.indented = true;
    if line ifStatement.add(line);
    if otherwise
		{
		item = otherwise.get("statement");
		line = item.value;
		if line ifStatement.add(line);
		}
    ifStatement.pointInCode = iTEM;
    statement.value = ifStatement;
return true;
}


int StatementBody4TawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM.children["statement"];
PLGitem instance = iTEM.children["instance"];
Instance    returnValue;
Statement   line = new(RETURN);						// return
    if instance
		{
		returnValue = instance.value;
		line.add(returnValue);
		}
    line.branch = true;
    statement.value = line;
return true;
}


int StatementBody5TawkNow(PLGitem iTEM)
{
PLGitem instance = iTEM.children["instance"];
PLGitem statement = iTEM.children["statement"];
Statement   forStatement = instance.value,
			body;
    body = statement.value;
	body.indented = true;
    forStatement.fourth = new Instance(body);       // for
    forStatement.pointInCode = iTEM;
    statement.value = forStatement;
    iterating--;
return true;
}


int StatementBody6TawkNow(PLGitem iTEM)
