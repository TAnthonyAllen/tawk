		part = item.get("instance");
		right = part.value;
		if left
			{
			express = new(left,right,",");
			left = new(express);
			}
		else left = right;
		}
    list.value  = left;
    noShortcuts = false;
return true;
}


int ExpressPartTawkNow(PLGitem iTEM)
{
PLGitem unaryOp = iTEM.children["unaryOp"];
PLGitem instance = iTEM.children["instance"];
PLGitem express = iTEM.children["express"];
Expression  expression;
Instance    secondary,primary;
PLGitem		item,
            operand,
            operate,
            stringPart;
SymbolType	type, secondaryType;
    primary = instance.value;
	type = primary.getType();
    expressType = null;
	if express
		{
		if operate	= express["operate"]
			{
			operand	= operate%"operand";
			if !operand operand = operate%"comparator";
			}
		item	= express.get("instance");
		if item
            {
            secondary = item.value;
            if secondary.isRange
                {
                expression = convertRangeX(primary,secondary);
                primary = new(expression);
                }
            else {
                secondaryType = secondary.getType();
                if !operand && secondary && secondary.express
                    && secondary.verb eq ":"
                    {
                    expression = new(primary,secondary,"?");
                    primary = new(expression);
                    }
                or operand && operand eq "+=" && type == stringType
                    && secondaryType == stringType && primary.howDirect() == 1
                    {
                    operand.setString("=");
                    //cursor = item.start;
                    stringing   = true;
                    if stringPart = parse("Strings")
                        {
//dealWith next
                        item.next       = stringPart;
                        instance.next   = item;
                        }
                    else instance.next  = item;
                    secondary = concatenate(instance);
                    expression = new(primary,secondary,"=");
                    primary = new(expression);
                    }
                }
            }
		}
	if !expression && (primary.isVirtuous() || operand)
		{
		expression = makeExpress(primary,express);
		primary = new(expression);
		}
    if unaryOp
        {
//dealWith next
        if unaryOp eq "&" && !unaryOp.next
            primary.reference = true;
        else {
            expression = new((Instance)null,primary,unaryOp.toString());
            primary = new(expression);
            }
        }
    primary         = primary.checkOverload();
    if primary.symbol && primary.symbol.isDefault
        primary.setDefaults(p);
    instance.value  = primary;
    currentType     = null;
    popVirtuals();
return true;
}


