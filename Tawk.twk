int MethodTawkNow(PLGitem iTEM)
{
PLGitem method = iTEM["method"];
PLGitem block = iTEM["block"];
Tawk	p = iTEM.testParser;
PLGitem	    body = block.get("start"),
			head = method.find("head");
Instance    instance;
    method.value = head.value;
    instance = method.value;
    checkSymbol();
    symbol.block = body.value;
    symbol.block.isMethodBlock = true;
    if currentComment
		symbol.comment = extractComment();
	missingMethods.remove(instance.methodName);
	if directives cout `methodName,"has directives":;
    else cout `methodName:;
    currentMethod   = null;
    produceCodeFile = true;
    /***************************************************************************
        external methods declared in the current file get added to internalType
        so they get declared in the Start rule. The parentClass of the method
        is reset to globalType (internalType is not for public consumption).
    ***************************************************************************/
    if symbol.parentClass && symbol.parentClass.isExternal && symbol.parentClass.isGlobal
        {
        SymbolType.internalType.addMethod(symbol);
        symbol.parentClass = globalType;
        }
return true;
}

