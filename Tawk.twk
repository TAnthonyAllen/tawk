int StatementBody18TawkNow(PLGitem iTEM)
{
PLGitem statement = iTEM.children["statement"];
PLGitem		declare = statement.get("declare");
PLGitem		entry;
Statement   line;
Instance    stacked,
            instance;
Expression	express = null;
    statement.runDeferred(this);                                // declaration
    virtualStack.clear();
	for entry = declare
		{
		instance = entry.value;
		if !instance || instance.type continue;
		if instance.symbol && symbol.type.hasInitializer && entry["initialize"]
            {
            Expression  initialize;
            /*************************************************************
                The instance being declared does not have an initializing
                expression but its class has an initializer method
                (specified as an initializer in an external type declaration).
                Add the call to the initializer here.
            *************************************************************/
            Instance assigned    = findInitializer(symbol);
            if assigned
                {
                Instance argument       = new(instance.symbol.name);
                argument.isConstant     = true;
                argument.indirection    = 1;
                argument.type           = stringType;
                assigned.addParameter(argument);
                if assigned.isDefault assigned.setDefaults(p);
                initialize  = new(instance,assigned,"=");
                instance    = new(initialize);
                }
            }
		if instance.symbol
            {
            virtualStack    += instance;
            instance.isLocal = true;
            }
		or instance.express
            if instance.isRange
                virtualStack += instance;
            else {
                Instance temp   = instance.express.subject;
                virtualStack    += temp;
                temp.isLocal    = true;
                }
		if express
			{
			express.verb = commaOp;
			express.object = instance;
			if instance.symbol
				instance.isDeclaration = false;
			if instance.express
				instance.subject.isDeclaration = false;
			instance = new(express);
			}
		if entry.next
			{
			express = new();
			express.subject = instance;
			}
		}
    if virtualStack.length
        {
        virtualStack.entry = null;
        while stacked = virtualStack.next()
            currentSymbols.add(stacked);
        virtualStack.clear();
        }
    if !instance.isRange
        {
        instance.isDeclaration = true;
        line = new;
        line.add(instance);
        line.indented = false;
        statement.value = line;
        }
return true;
}


