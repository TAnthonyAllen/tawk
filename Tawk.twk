        //cout `"Done with " start:;
        }
    else cerr "Include: source file already loaded, now ignored:",sourceFile:;
return true;
}


int InstanceTailTawkNow(PLGitem iTEM)
{
PLGitem array = iTEM.children["array"];
PLGitem	item;
double  i = 0;
	for item = array
		i++;
	array.amount = i;
    noShortcuts = false;
return true;
}


int LambdaTawkNow(PLGitem iTEM)
{
PLGitem function = iTEM.children["function"];
PLGitem body = iTEM.children["body"];
PLGitem		item	= function.get("name");
Instance    lambda	= item.value,
			lambdaBody;
Expression	express;
Block		block;
    lambda.isAssigned = true;
    lambda.assigning = true;
	item			= body.get("start");
	block			= item.value;
	block.isLambda	= true;
	lambdaBody		= new(block);
	express			= new(lambda,lambdaBody,"=");
	lambda			= new(express);
	function.value	= lambda;
return true;
}


int Lambda2TawkNow(PLGitem iTEM)
{
PLGitem function = iTEM.children["function"];
PLGitem body = iTEM.children["body"];
Instance	instance,
			bodyInstance;
PLGitem	    item;
Statement	line;
Block		block;
	item	= function.find("head");
	instance = item.value;
    if !instance.isLambda return false;
	instance.isDeclaration = true;
    instance.isAssigned = true;
	currentSymbols.add(instance);
	line	= new(LAMBDA);
    line.pointInCode = iTEM;
	line.add(instance);
	item	= body.get("start");
	block	= item.value;
    currentClass.hasLambda = true;
	block.isLambda	= true;
	bodyInstance = new(block);
    line.add(bodyInstance);     // replaces prior commented out line
	instance = new(line);
    function.value = instance;
return true;
}


