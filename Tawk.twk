    rule = rules[text];
    if !rule
        cerr "Rule not found: " text "\n";
    else {
        rule.debug = true;
        if upcoming
            {
            PLGitem body = upcoming.get("body");
            if body rule.debugText = body.toString();
            }
        }
    name.unString();
return true;
}

