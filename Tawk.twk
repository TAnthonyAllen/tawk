    if conditionItem = list.value
        if conditionText = conditionItem.value
            if item = divertInput(conditionText,"Expression")
                {
                text = item.get("instance");
                if text
                    list.value = text.value;
                else {
                    condition = new();
                    condition.error("Failed parse of condition list");
