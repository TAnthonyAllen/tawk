include includes

/*******************************************************************************
	The Expression class holds an operation triplet, that is, an operator
	and two Instances (each of which might be an expression in turn)
*******************************************************************************/
class Expression
{
Operate     verb;
Instance	subject,
			object;
boolean
			buttoned
			checked
            full
			hasParens
            reordered
			;
static BaseHash	CompareOperators;

Expression()
{
    // this does not do anything except initialize contents to null
}

Expression(Instance s,Instance o,String v)
{
    subject		= s;
    object		= o;
    if v
        verb    = verbs[v];
    else verb   = null;
    if subject && object && verb full = true;
}

Expression(Instance s,Instance o,Operate v)
{
    subject		= s;
    object		= o;
    verb        = v;
    if subject && object && verb full = true;
}

/*******************************************************************************
        Runs all fields thru a sanity check
*******************************************************************************/
void check()
{
    if subject  subject.check();
    if object   object.check();
}

/*******************************************************************************
        Checks casting of ?: expressions
*******************************************************************************/
void checkCast(Instance target)
{
	if verb && verb eq "?"
		{
		object.express.checkCast(target);
		return;
		}
	if !verb || verb ne ":" return;
	subject = subject.checkCast(target);
	object  = object.checkCast(target);
}

/*****************************************************************************
	Checks the expression for errors
*****************************************************************************/
void checkExpression(FormatC formatter)
{
SymbolType  subjectType = null,
			objectType = null;
    if checked return;
	if subject  subjectType = subject.getType();
    if object   objectType  = object.getType();
 	if subjectType == buttonType || objectType == buttonType
		if jitting handleBooleans();
        else handleButtons();
    if subject
		{
		if !subject.symbol && !subject.isConstant && !subject.express
			subject.error("expected a symbol or expression");
		or !subjectType
			subject.error("expression subject is missing type");
		if subject.isError goto endCheckExpress;
        if jitting && subject.symbol && subject.symbol.structType && subject.symbol.structType.isBoolean
            handleBooleans();
		}
    if object && verb
		{
		if subject && subject.isConstant && verb.assign
			subject.error("Invalid assignment subject");
		if object.isError goto endCheckExpress;
		objectType = object.getType();
		if object.express
			object.express.checkExpression(formatter);
		formatter.convert(this);
		if subject subjectType = subject.getType();
		objectType = object.getType();	// types might have been change by convert
		if verb eq "&&" || verb eq "||"
			goto endCheckExpress;
		/***********************************************************************
			Check subject for setter. There is no conversion to setter if the
            enclosing method is a setter, getter or constructor.
		***********************************************************************/
		if !buttoned && verb.assign
            {
            SymbolType enclosingType;
            if enclosingMethod enclosingType = enclosingMethod.parentClass;
            if subject
                {
                Symbol method = subject.getSymbol();
                if method && op == '='
                    {
                    if method.isGetter
                        {
                        /***********************************************************
                            Replaces the getter method w/getter target symbol
                            Since cannot have a getter as the subject of an assign
                        ***********************************************************/
                        subject.symbol  =
                        method          = method.getter;
                        subject.isMethod = false;
                        }
                    if method = method.setter
                        {
                        Instance methodParent = subject.findGetterOrSetter(method.name);
                        if subject.symbol
                            && method && method != enclosingMethod
                            && (!enclosingMethod || (!enclosingMethod.isSetter && !enclosingMethod.isConstructor && !enclosingMethod.isGetter))
                            && (method.parentClass == enclosingType || methodParent)
                            {
                            Instance instance;
                            instance = new(method);
                            /*******************************************************
                                The following caveat is added so that a setter can
                                apply on a component field
                            *******************************************************/
                            if methodParent     instance.parent = methodParent;
                            // Test this Not sure if it works: if method.parentClass.isC && subject.parent insertParentAsParameter();
                            instance.addParameter(object.checkCast(subject));
                            object  = null;
                            verb    = null;
                            full    = false;
                            subject = instance;
                            }
                        or method = object.getSymbol()
                            if method = method.getter
                                {
                                methodParent = object.findGetterOrSetter(method.name);
                                if method.parentClass == enclosingType || methodParent
                                    {
                                    object.symbol   = method;
                                    object.express  = null;
                                    object.isMethod =  true;
                                    object.parent   = null;
                                    if methodParent     object.parent = methodParent;
                                    }
                                }
                        }
                    }
                }
noSetter:
            if object && object.express object.express.checkCast(subject);
            }
		/***********************************************************************
			Check object for up cast and boolean reference
		***********************************************************************/
		if object
            {
            if !object.cast && subjectType && objectType
                && subjectType.hasParent(objectType)
                object = object.checkCast(subject);
            if jitting && object.symbol && object.symbol.type.isBoolean
                handleBooleans();
            }
		}
endCheckExpress:
    checked = true;
}

/*****************************************************************************
	Converts this expression into a call to .
*****************************************************************************/
Instance convertBoolean(Instance item,int setterFlag)
{
Instance    instance,
            newSubject;
Symbol      handler,
            itemObject;
SymbolType  uChar = types.getType("unsigned char");
int         buttonFlag;
use item
    if symbol.type == buttonType buttonFlag = true;
    if symbol && symbol.isItem
        {
        // The following sets instance as a pointer to the item parent object cast as unsigned char*
        if !(instance = item.parent)
            {
            itemObject  = new("this",symbol.parentClass);
            instance    = new(itemObject);
            }
        instance.cast   = new(uChar);
        instance.cast.indirection   = 1;
        instance.cast.isCast        = true;

        if setterFlag
            if buttonFlag
                handler     = globalType.ownMethod("setButton");
            else handler    = globalType.ownMethod("setBoolean");
        or buttonFlag
            handler     = globalType.ownMethod("buttonIsSet");
        else handler    = globalType.ownMethod("booleanIsSet");
        newSubject      = new(handler);
        newSubject.isMethod = true;
        newSubject.addParameter(instance);
        if buttonFlag
            instance    = new(toString((int)item.source.symbolOffset));
        else instance   = new(toString((int)symbol.symbolOffset));
        instance.isConstant = true;
        instance.type       = intType;
        newSubject.addParameter(instance);
        if buttonFlag
            instance    = new(toString((int)item.source.symbolBitOffset));
        else instance   = new(toString((int)symbol.symbolBitOffset));
        instance.isConstant = true;
        instance.type       = intType;
        newSubject.addParameter(instance);
        if buttonFlag
            {
            instance            = new(toString((int)item.source.symbolBitLength));
            instance.isConstant = true;
            instance.type       = intType;
            newSubject.addParameter(instance);
            instance            = new(symbol.array);
            instance.isConstant = true;
            instance.type       = intType;
            newSubject.addParameter(instance);
            }
        or setterFlag
            newSubject.addParameter(object);
        return newSubject;
        }
    return item;
}

/*******************************************************************************
        Debugging routine
*******************************************************************************/
void dump()
{
    cout toString():;
}

/*******************************************************************************
        Get the SymbolType associated with this expression
*******************************************************************************/
SymbolType getType()
{
SymbolType	subjectType, objectType;
	if object objectType = object.getType();
	if verb
        {
		if verb.comparison
            if object.express && object.verb && object.verb eq "?"
                return object.getType();
            else return intType;
		if verb eq "?" return objectType;
        }
	if subject
		{
		subjectType = subject.getType();
		if verb && subjectType == objectType && subject.howDirect()
            && (verb eq "-" || verb eq "+")
			return SymbolType.intType;
		else return subjectType;
		}
	return objectType;
}

/*****************************************************************************
	Handle boolean and button references in the expression. Only called when
    jitting to handle addressing and bit manipulation.
*****************************************************************************/
void handleBooleans()
{
int         setterFlag;
Instance    newItem;
    if object && object.symbol
        && ((object.symbol.structType && object.symbol.structType.isBoolean)
            || object.symbol.type == buttonType)
        object = convertBoolean(object,false);
    if subject && subject.symbol
        && ((subject.symbol.structType && subject.symbol.structType.isBoolean)
            || subject.symbol.type == buttonType)
        {
        if verb && verb.assign
            setterFlag  = true;
        newItem = convertBoolean(subject,setterFlag);
        if subject != newItem
            subject = newItem;
        }
    if setterFlag
        {
        object          = null;
        verb            = null;
        }
}

/*****************************************************************************
	Handle button references in the expression. Note, buttons have source
    set but they are not aliases.
*****************************************************************************/
void handleButtons()
{
Symbol		button;
Instance    buttonInstance;
	if verb && verb eq "="
		{
		button = subject.symbol;
		if button && button.type == buttonType
			{
            subject = new(subject);
			subject.symbol = button.source;
			buttoned = true;
			if (object.isConstant && object.prefix eq "1")
				|| (object.symbol && object.symbol.name eq "1")
				{
                object          = new(object);
				object.type		= intType;
				object.symbol	= null;
				object.prefix	= button.array;
				object.isConstant = true;
				}
			else {
				SymbolType objectType = object.getType();
				if !objectType.isNumber
					{
                    object          = new(object);
					object.type		= intType;
					object.symbol	= null;
					object.prefix	= "0";
					object.isConstant = true;
					}
				}
			}
		if object.symbol
			{
			button = object.getSymbol();
			if button && button.isButton
				{
                buttonInstance = new(button);
                buttonInstance.isMethod = true;
                object = new(object);
				object.symbol = button.source;
                buttonInstance.addParameter(object);
                object = buttonInstance;
				}
			}
		}
	else {
		if subject && subject.symbol
			{
			button = subject.getSymbol();
			if button && button.isButton
				{
                buttonInstance = new(button);
                buttonInstance.isMethod = true;
                subject = new(subject);
				subject.symbol = button.source;
                buttonInstance.addParameter(subject);
                subject = buttonInstance;
				buttoned = true;
				}
			}
		if object && object.symbol
			{
			button = object.getSymbol();
			if button && button.isButton
				{
                buttonInstance = new(button);
                buttonInstance.isMethod = true;
                object = new(object);
				object.symbol = button.source;
                buttonInstance.addParameter(object);
                object = buttonInstance;
				}
			}
		}
}

/*******************************************************************************
        Rearranges the expression to deal w/operator precedence
*******************************************************************************/
void reorder()
{
    if full && !reordered && object.express && object.full
        && !object.hasParens && rank < object.rank
        {
        Instance oldObject  = object;
        Operate oldVerb     = verb;
        verb                = object.verb;
        object              = oldObject.object;
        oldObject.object    = oldObject.subject;
        oldObject.subject   = subject;
        oldObject.verb      = oldVerb;
        subject             = oldObject;
        reordered           = true;
        }
}

/*******************************************************************************
        Create a string representation of this expression
*******************************************************************************/
String toString()
{
String text;
    if full
        text = subject.toString() " " verb.op " " object.toString();
    or subject text = subject.toString();
    or object text = object.toString();
    if hasParens text = "(" text ")";
    return text;
}
}
