include includes

/*******************************************************************************
        This is just a shell class for running tok main - Need to redesign tok
		so that you can have a source file with no class, just globals
*******************************************************************************/
class Tok
{
int	dummy;
static Tape     globalLinkTape;
static Tawk     tawking;
static Tawk     testParser;     // set-and-forget parser handle for the FAIL handlers

void run()
{
	return;
}
}

/*****************************************************************************
	main program
*****************************************************************************/
int main( int argc, char **argv )
{
String sourceFile = argv[1];
    tawking	= new();
    testParser = tawking;
    if argc == 3 directivesFile = argv[2];
    if sourceFile
		{
		tawking.process(sourceFile);
		cout "Parsed " sourceFile, symbolCount,instanceCount,componentCount "\n";
		//tawking.summary(5);
		}
    else {
		cerr "No source file provided. Usage: tok sourceFile directivesFile(optional)":;
		exit(1);
		}
    exit(0);
}

/*****************************************************************************
	Rule FAIL handlers. These were free functions in Tawk.g's %% epilogue
	(which plg's regen does not carry). Moved here as file-scope externals;
	wired by name in setRules via the grammar's FAIL directives. The parser
	is the set-and-forget Tok::testParser static (was reached via the
	PLGtester chain iTEM.test.testParser in the old model).
*****************************************************************************/
void assignFailed(PLGitem iTEM)
{
Tawk    tOK = testParser;
    if tOK.assigning
        {
        tOK.assigning = false;
        cout "Assigning turned off":;
        }
}

void caseLabelFail(PLGitem iTEM)
{
Tawk    tOK = testParser;
    tOK.assuming = false;
}

void expressPartFailed(PLGitem iTEM)
{
Tawk    tOK = testParser;
    tOK.popVirtuals();
}

void instanceTailFail(PLGitem iTEM)
{
Tawk    tOK = testParser;
    tOK.noShortcuts = false;
    tOK.printErrorMessage();
}
