    number.isConstant = true;
    number.type = type;
	if isLong number.postfix = "LL";
    instance.value = number;
enD

PoundCommand
SymbolType	symbolType;
PLGitem     end = state;
PLGitem     selectedField;
    switch(*state.start)
        {
        case 'a':
            if currentClass
                currentClass.autoGetSet = !currentClass.autoGetSet;
            break;
        case 'd':
            if *(state.start + 1) == 'E'
                if list
                    {
                    debug = false;
                    end = list;
                    }
                or debug
                    debug = false;
                else debugRulePLG = true;
            else {
                if type
                    {
                    if symbolType = type.value
                        {
                        symbolType.dump();
                        if field symbolType.dumpFields();
                        }
                    if field end = field;
                    else end = type;
                    }
                or level
                    {
                    currentSymbols.dump();
                    end = level;
                    }
                else {
                    currentSymbols.dump("Symbol Table");
                    dumpGlobals();
                    }
                }
            break;
        case 'i':
            if currentMethod
                {
                currentMethod.isInitialized = true;
                if currentMethod.isAlias currentMethod.source.isInitialized = true;
                }
            break;
        case 'm':
            debugging = !debugging;
            break;
        case 'r':
            defaultPrinter = currentSymbols.find("printf");
            break;
        case 's':
            summaryDebug();
            break;
        case 't':
            cout "At trace: " symbolCount,instanceCount:;
            //debugTest = !debugTest;
        }
    cursor        = end.start + end.length;
enD

Quote
Buffer      buffer = tokJunkBuffer;
Instance    current;
char		*mark;
    /**********************************************************************
	    Check for multi-line strings
    **********************************************************************/
    buffer.reset();
    if !body    current = new("");
    else {
        mark    = body.string();
        while *mark {
			if *mark == '\n' {
                buffer += '\\';
                buffer += 'n'; }
            else    buffer += *mark;
            mark++; }
        current = new(buffer.toString());
        body.unString(); }
    isConstant  = true;
    indirection = 1; // constant strings are really pointers
    type        = SymbolType.stringType;
    if string   atString = true;
    instance.value      = current;
enD

DebugText
    cout "DebugText got here",upcoming:;
enD

DebugRule
PLGrule	rule;
String	text = name.string();
    rule = rules[text];
    if !rule
        cerr "Rule not found: " text "\n";
    else {
        rule.debug = true;
        if upcoming
            {
            PLGitem body = upcoming.get("body");
            if body rule.debugText = body.toString();
            }
        }
    name.unString();
enD

Stop
	// This is a dummy rule to stick wherever for debugging
enD

SyntaxExtensions defer
enD

SyntaxExtensions:2
Symbol  symbol;
use currentClass
    if aliasStack && aliasStack.length
        {
        aliasStack.entry = null;
        while symbol = aliasStack.next()
            add(symbol);
        aliasStack.clear();
        }
enD
